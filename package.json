    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:prepare": "tsx scripts/e2e-prepare.ts",
    "test:mobile": "playwright test tests/e2e/mobile-companion.spec.ts",
