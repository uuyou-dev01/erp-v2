    "mobile:notifications": "tsx scripts/mobile-notification-outbox.ts",
    "mobile:retention": "tsx scripts/mobile-retention.ts",
    "data:retention": "tsx scripts/data-retention.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:mobile && npm run test:smoke"
  },
  "dependencies": {
