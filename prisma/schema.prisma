// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE: Store & Multi-tenancy
// ============================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores      Store[]
  memberships Membership[]

  @@map("organizations")
}

model Store {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  code           String   @unique
  currency       String   @default("CNY")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization             Organization?                    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  users                    User[]
  storeAccesses            StoreAccess[]
  skus                     SKU[]
  productIntelItems        ProductIntelligenceItem[]
  productIntelObservations ProductIntelligenceObservation[]
  locations                Location[]
  inventoryLots            InventoryLot[]
  itemUnits                ItemUnit[]
  stockLedgers             StockLedger[]
  purchaseOrders           PurchaseOrder[]
  customerOrders           CustomerOrder[]
  inventorySplits          InventorySplit[]
  platforms                Platform[]
  listings                 Listing[]
  resaleListings           ResaleListing[]
  supplyReservations       SupplyReservation[]
  fulfillmentRequests      FulfillmentRequest[]
  settlements              Settlement[]
  partners                 Partner[]
  tradingRelationships     TradingRelationship[]
  supplyOffers             SupplyOffer[]
  offerVisibilityRules     OfferVisibility[]                @relation("OfferVisibilityStore")
  importJobs               ImportJob[]
  quickEntries             QuickEntry[]
  inboundShipments         InboundShipment[]
  consolidationBatches     ConsolidationBatch[]
  inspectionEvents         InspectionEvent[]

  @@index([organizationId])
  @@map("stores")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("USER")
  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  memberships   Membership[]
  storeAccesses StoreAccess[]

  @@index([storeId])
  @@map("users")
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("VIEWER")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model StoreAccess {
  id          String   @id @default(cuid())
  storeId     String
  userId      String
  role        String   @default("VIEWER")
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_accesses")
}

model Task {
  id             String    @id @default(cuid())
  organizationId String
  storeId        String
  type           String
  status         String    @default("OPEN")
  priority       String    @default("NORMAL")
  title          String
  description    String?   @db.Text
  refType        String
  refId          String
  createdById    String
  assignedToId   String?
  delegatedToId  String?
  completedById  String?
  assignedAt     DateTime?
  dueAt          DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([storeId])
  @@index([type])
  @@index([status])
  @@index([assignedToId])
  @@index([completedById])
  @@index([refType, refId])
  @@map("tasks")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  storeId        String?
  recipientId    String
  actorId        String?
  taskId         String?
  refType        String?
  refId          String?
  type           String
  title          String
  body           String?   @db.Text
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([storeId])
  @@index([recipientId])
  @@index([actorId])
  @@index([taskId])
  @@index([readAt])
  @@map("notifications")
}

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String?
  actorId        String?
  action         String
  refType        String
  refId          String
  taskId         String?
  before         Json?
  after          Json?
  message        String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([storeId])
  @@index([actorId])
  @@index([action])
  @@index([refType, refId])
  @@index([taskId])
  @@map("activity_logs")
}

// ============================================
// PRODUCT: SKU
// ============================================

model SKU {
  id               String   @id @default(cuid())
  storeId          String
  code             String
  name             String
  parentSkuId      String?
  catalogRole      String   @default("SIMPLE") // GROUP, VARIANT, SIMPLE
  manufacturerCode String?
  variantLabel     String?
  variantAxes      Json?
  variantValues    Json?
  nameSource       String   @default("AUTO") // AUTO, MANUAL
  codeSource       String   @default("AUTO") // AUTO, MANUAL
  category         String?
  brand            String?
  attributes       Json?
  description      String?
  imageUrl         String?
  isAutoCreated    Boolean  @default(false)
  mergeStatus      String? // PENDING, CONFIRMED, MERGED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parentSku        SKU?              @relation("SkuVariants", fields: [parentSkuId], references: [id], onDelete: SetNull)
  childSkus        SKU[]             @relation("SkuVariants")
  inventoryLots    InventoryLot[]
  itemUnits        ItemUnit[]
  purchaseLines    PurchaseLine[]
  orderLines       OrderLine[]
  listings         Listing[]
  supplyOffers     SupplyOffer[]
  supplyOfferItems SupplyOfferItem[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([storeId, catalogRole])
  @@index([parentSkuId])
  @@index([manufacturerCode])
  @@map("skus")
}

model ProductIntelligenceItem {
  id           String   @id @default(cuid())
  storeId      String
  parentItemId String?
  title        String
  brand        String?
  category     String?
  model        String?
  productKind  String   @default("NEW") // NEW, USED, MIXED
  description  String?  @db.Text
  imageUrl     String?
  tags         Json?
  visibility   String   @default("PUBLIC") // PUBLIC, ORGANIZATION, PRIVATE
  status       String   @default("ACTIVE") // ACTIVE, HIDDEN, ARCHIVED
  createdById  String?
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store        Store                            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parentItem   ProductIntelligenceItem?         @relation("ProductIntelligenceVariants", fields: [parentItemId], references: [id], onDelete: SetNull)
  childItems   ProductIntelligenceItem[]        @relation("ProductIntelligenceVariants")
  observations ProductIntelligenceObservation[]

  @@index([storeId])
  @@index([parentItemId])
  @@index([visibility])
  @@index([status])
  @@index([category])
  @@index([updatedAt])
  @@map("product_intelligence_items")
}

model ProductIntelligenceObservation {
  id             String   @id @default(cuid())
  itemId         String
  storeId        String
  sourceType     String   @default("MANUAL") // MANUAL, REAL_PURCHASE, REAL_SALE, MARKET_SEEN, PLATFORM_LISTING, SUPPLY_OFFER
  priceType      String   @default("SALE") // PURCHASE, SALE, WHOLESALE, RESALE, OFFER
  amount         Decimal  @db.Decimal(19, 4)
  currency       String
  quantity       Decimal? @db.Decimal(19, 4)
  sourceName     String?
  platformName   String?
  conditionGrade String?
  confidence     String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  visibility     String   @default("PUBLIC") // PUBLIC, ORGANIZATION, PRIVATE
  observedAt     DateTime @default(now())
  note           String?  @db.Text
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  item  ProductIntelligenceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  store Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([storeId])
  @@index([sourceType])
  @@index([priceType])
  @@index([visibility])
  @@index([observedAt])
  @@map("product_intelligence_observations")
}

// ============================================
// INVENTORY: Location, Lot, ItemUnit, Ledger
// ============================================

model Location {
  id                String   @id @default(cuid())
  storeId           String
  code              String
  name              String
  region            String? // CN_SHANGHAI, JP_TOKYO, JP_OSAKA, ...
  type              String // WAREHOUSE, FORWARDER, PERSON, TRANSIT
  isSellableDefault Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store                Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryLots        InventoryLot[]
  itemUnits            ItemUnit[]
  stockLedgers         StockLedger[]
  inboundShipmentsFrom InboundShipment[]    @relation("ShipmentFrom")
  inboundShipmentsTo   InboundShipment[]    @relation("ShipmentTo")
  consolidationFrom    ConsolidationBatch[] @relation("ConsolidationFrom")
  consolidationTo      ConsolidationBatch[] @relation("ConsolidationTo")
  inspections          InspectionEvent[]
  purchaseOrdersDest   PurchaseOrder[]

  @@unique([storeId, code])
  @@index([storeId])
  @@map("locations")
}

model InventoryLot {
  id           String   @id @default(cuid())
  storeId      String
  skuId        String
  locationId   String
  unitCost     Decimal  @db.Decimal(19, 4)
  costCurrency String
  fxRateId     String?
  sourceType   String // PURCHASE, SPLIT
  sourceId     String
  receivedAt   DateTime
  batchLabel   String?
  status       String   @default("ACTIVE") // ACTIVE, CONSUMED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku         SKU               @relation(fields: [skuId], references: [id], onDelete: Cascade)
  location    Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  allocations OrderAllocation[]

  @@index([storeId])
  @@index([skuId])
  @@index([locationId])
  @@index([status])
  @@map("inventory_lots")
}

model ItemUnit {
  id             String    @id @default(cuid())
  storeId        String
  skuId          String
  locationId     String
  unitCost       Decimal   @db.Decimal(19, 4)
  costCurrency   String
  fxRateId       String?
  unitCode       String?
  labelCode      String?
  labelStatus    String    @default("PENDING") // PENDING, PRINTED, ATTACHED
  labelPrintedAt DateTime?
  conditionGrade String?
  photos         Json?
  ownerId        String?
  holderId       String?
  notes          String?   @db.Text
  sourceType     String // PURCHASE, SPLIT
  sourceId       String
  status         String    @default("AVAILABLE") // AVAILABLE, ALLOCATED, CONSUMED, RETURN_CHECK
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku              SKU               @relation(fields: [skuId], references: [id], onDelete: Cascade)
  location         Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  allocations      OrderAllocation[]
  listings         Listing[]
  supplyOffers     SupplyOffer[]
  supplyOfferItems SupplyOfferItem[]

  @@unique([storeId, unitCode])
  @@unique([storeId, labelCode])
  @@index([storeId])
  @@index([skuId])
  @@index([locationId])
  @@index([status])
  @@map("item_units")
}

model StockLedger {
  id         String   @id @default(cuid())
  storeId    String
  occurredAt DateTime @default(now())
  entityType String // LOT, ITEM_UNIT
  entityId   String
  locationId String
  deltaQty   Decimal  @db.Decimal(19, 4)
  reason     String // INBOUND_PURCHASE, OUTBOUND_SALE, ALLOCATE, DEALLOCATE, ADJUST, TRANSFER_OUT, TRANSFER_IN, SPLIT_OUT, SPLIT_IN
  refType    String?
  refId      String?
  meta       Json?
  createdAt  DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([entityType, entityId])
  @@index([locationId])
  @@index([occurredAt])
  @@map("stock_ledgers")
}

// ============================================
// INVENTORY: Split
// ============================================

model InventorySplit {
  id               String   @id @default(cuid())
  storeId          String
  splitType        String // UNBOX, DISASSEMBLE, CUSTOM
  sourceType       String // LOT, ITEM_UNIT
  sourceId         String
  occurredAt       DateTime @default(now())
  totalSourceCost  Decimal  @db.Decimal(19, 4)
  allocationMethod String   @default("PROPORTIONAL_BY_QTY")
  createdById      String?
  createdAt        DateTime @default(now())

  store Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lines InventorySplitLine[]

  @@index([storeId])
  @@index([sourceType, sourceId])
  @@map("inventory_splits")
}

model InventorySplitLine {
  id            String  @id @default(cuid())
  splitId       String
  targetType    String // LOT, ITEM_UNIT
  targetId      String
  quantity      Decimal @db.Decimal(19, 4)
  allocatedCost Decimal @db.Decimal(19, 4)

  split InventorySplit @relation(fields: [splitId], references: [id], onDelete: Cascade)

  @@index([splitId])
  @@map("inventory_split_lines")
}

// ============================================
// PROCUREMENT: Purchase Orders
// ============================================

model PurchaseOrder {
  id                    String    @id @default(cuid())
  storeId               String
  orderNo               String
  supplierId            String?
  supplierName          String?
  currency              String
  fxRate                Decimal?  @db.Decimal(19, 8)
  subtotal              Decimal   @db.Decimal(19, 4)
  totalAmount           Decimal   @db.Decimal(19, 4)
  status                String    @default("DRAFT") // DRAFT, ORDERED, SHIPPED, RECEIVED, CANCELLED
  orderedAt             DateTime?
  shippedAt             DateTime?
  etaDate               DateTime?
  receivedAt            DateTime?
  trackingNo            String?
  carrier               String?
  shipmentNote          String?   @db.Text
  destinationLocationId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  store               Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  destinationLocation Location?         @relation(fields: [destinationLocationId], references: [id], onDelete: SetNull)
  lines               PurchaseLine[]
  inboundShipments    InboundShipment[]

  @@unique([storeId, orderNo])
  @@index([storeId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseLine {
  id                String   @id @default(cuid())
  purchaseOrderId   String
  skuId             String
  quantity          Decimal  @db.Decimal(19, 4)
  unitPrice         Decimal  @db.Decimal(19, 4)
  lineAmount        Decimal  @db.Decimal(19, 4)
  allocatedFee      Decimal  @default(0) @db.Decimal(19, 4)
  allocatedDiscount Decimal  @default(0) @db.Decimal(19, 4)
  forOrderLineId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sku           SKU           @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([skuId])
  @@map("purchase_lines")
}

// ============================================
// SALES: Customer Orders
// ============================================

model CustomerOrder {
  id                      String    @id @default(cuid())
  storeId                 String
  orderNumber             String    @unique
  platformId              String?
  resaleListingId         String?
  externalOrderNo         String?
  customerName            String
  customerEmail           String?
  customerPhone           String?
  shippingAddress         String?   @db.Text
  orderDate               DateTime
  currency                String
  subtotal                Decimal   @db.Decimal(19, 4)
  discountTotal           Decimal   @default(0) @db.Decimal(19, 4)
  shippingCharged         Decimal   @default(0) @db.Decimal(19, 4)
  totalPaid               Decimal   @db.Decimal(19, 4)
  platformFee             Decimal   @default(0) @db.Decimal(19, 4)
  shippingFee             Decimal   @default(0) @db.Decimal(19, 4)
  shippingProvider        String?
  shippingProviderFeeRate Decimal?  @db.Decimal(8, 4)
  netRevenue              Decimal?  @db.Decimal(19, 4)
  countryFlow             String?
  orderStatus             String    @default("DRAFT") // DRAFT, PLACED, PAID, CONFIRMED, SHIPPED, DELIVERED, RETURNED, CANCELLED
  shippedAt               DateTime?
  trackingNo              String?
  shippingProof           Json?
  settledAt               DateTime?
  createdAt               DateTime  @default(now())
  confirmedAt             DateTime?
  updatedAt               DateTime  @updatedAt

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform            Platform?            @relation(fields: [platformId], references: [id])
  resaleListing       ResaleListing?       @relation(fields: [resaleListingId], references: [id], onDelete: SetNull)
  lines               OrderLine[]
  fulfillmentRequests FulfillmentRequest[]
  settlements         Settlement[]

  @@index([storeId])
  @@index([orderStatus])
  @@index([platformId])
  @@index([resaleListingId])
  @@map("customer_orders")
}

model OrderLine {
  id                String   @id @default(cuid())
  orderId           String
  skuId             String
  quantity          Decimal  @db.Decimal(19, 4)
  unitPrice         Decimal? @db.Decimal(19, 4)
  lineAmount        Decimal  @db.Decimal(19, 4)
  allocatedDiscount Decimal  @default(0) @db.Decimal(19, 4)
  allocatedFee      Decimal  @default(0) @db.Decimal(19, 4)
  supplyType        String   @default("FROM_STOCK") // FROM_STOCK, PURCHASE_FOR_ORDER
  supplyStatus      String   @default("UNFULFILLED") // UNFULFILLED, ALLOCATED_FROM_STOCK, PURCHASE_REQUESTED, PURCHASED_INBOUND, READY_TO_SHIP, CONSUMED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order       CustomerOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         SKU               @relation(fields: [skuId], references: [id], onDelete: Cascade)
  allocations OrderAllocation[]

  @@index([orderId])
  @@index([skuId])
  @@map("order_lines")
}

model OrderAllocation {
  id             String   @id @default(cuid())
  orderLineId    String
  allocationType String // LOT, ITEM_UNIT
  lotId          String?
  itemUnitId     String?
  quantity       Decimal  @db.Decimal(19, 4)
  unitCost       Decimal  @db.Decimal(19, 4)
  costAmount     Decimal  @db.Decimal(19, 4)
  status         String   @default("PENDING") // PENDING, ALLOCATED, SHIPPED, DELIVERED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderLine    OrderLine     @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  inventoryLot InventoryLot? @relation(fields: [lotId], references: [id], onDelete: Cascade)
  itemUnit     ItemUnit?     @relation(fields: [itemUnitId], references: [id], onDelete: Cascade)

  @@index([orderLineId])
  @@index([lotId])
  @@index([itemUnitId])
  @@map("order_allocations")
}

// ============================================
// SHARED: Fee
// ============================================

model Fee {
  id               String  @id @default(cuid())
  refType          String // PURCHASE_ORDER, CUSTOMER_ORDER, ORDER_LINE
  refId            String
  feeType          String // DISCOUNT, PLATFORM_FEE, SHIPPING_COST, PACKING_FEE, TAX
  amount           Decimal @db.Decimal(19, 4)
  currency         String
  allocationMethod String  @default("PROPORTIONAL_BY_AMOUNT")
  allocationBasis  String? // AMOUNT, QTY, WEIGHT

  @@index([refType, refId])
  @@map("fees")
}

// ============================================
// LISTING: Platforms & Listings
// ============================================

model Platform {
  id                 String   @id @default(cuid())
  storeId            String
  code               String
  name               String
  country            String?
  defaultFeeRate     Decimal? @db.Decimal(8, 4)
  defaultCurrency    String?
  defaultShippingFee Decimal? @db.Decimal(19, 4)
  shippingRules      Json?
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  listings       Listing[]
  resaleListings ResaleListing[]
  customerOrders CustomerOrder[]

  @@unique([storeId, code])
  @@index([storeId])
  @@map("platforms")
}

model Listing {
  id                  String    @id @default(cuid())
  storeId             String
  platformId          String
  skuId               String?
  itemUnitId          String?
  listingType         String // SKU, ITEM_UNIT
  listedPrice         Decimal?  @db.Decimal(19, 4)
  currency            String?
  feeRateOverride     Decimal?  @db.Decimal(8, 4)
  shippingFeeOverride Decimal?  @db.Decimal(19, 4)
  estimatedNet        Decimal?  @db.Decimal(19, 4)
  status              String    @default("ACTIVE") // ACTIVE, DELISTED
  listedAt            DateTime  @default(now())
  delistedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform            Platform             @relation(fields: [platformId], references: [id], onDelete: Cascade)
  sku                 SKU?                 @relation(fields: [skuId], references: [id], onDelete: Cascade)
  itemUnit            ItemUnit?            @relation(fields: [itemUnitId], references: [id], onDelete: Cascade)
  resaleListings      ResaleListing[]
  reservations        SupplyReservation[]
  fulfillmentRequests FulfillmentRequest[]

  @@index([storeId])
  @@index([platformId])
  @@index([skuId])
  @@index([itemUnitId])
  @@index([status])
  @@map("listings")
}

// ============================================
// MARKETPLACE: Partners & supply offers
// ============================================

model Partner {
  id              String   @id @default(cuid())
  storeId         String
  code            String
  name            String
  type            String   @default("SUPPLIER") // SUPPLIER, RESELLER, FULFILLER, CHANNEL, OTHER
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  defaultCurrency String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store                Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tradingRelationships TradingRelationship[]
  ownedSupplyOffers    SupplyOffer[]         @relation("SupplyOfferOwnerPartner")
  visibilityRules      OfferVisibility[]
  settlements          Settlement[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([status])
  @@map("partners")
}

model TradingRelationship {
  id                 String   @id @default(cuid())
  storeId            String
  partnerId          String
  relationshipType   String   @default("SUPPLY") // SUPPLY, RESELL, FULFILLMENT, CHANNEL
  visibilityScope    String   @default("PRIVATE") // PRIVATE, PARTNER_ONLY, PUBLIC
  status             String   @default("ACTIVE") // ACTIVE, INACTIVE
  commissionRate     Decimal? @db.Decimal(8, 4)
  serviceFeeRate     Decimal? @db.Decimal(8, 4)
  settlementCurrency String?
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([storeId, partnerId, relationshipType])
  @@index([storeId])
  @@index([partnerId])
  @@index([status])
  @@map("trading_relationships")
}

model SupplyOffer {
  id               String    @id @default(cuid())
  storeId          String
  ownerPartnerId   String?
  title            String
  description      String?   @db.Text
  visibility       String    @default("PRIVATE") // PRIVATE, PARTNER_ONLY, PUBLIC
  status           String    @default("DRAFT") // DRAFT, PUBLISHED, PAUSED, DELISTED
  sourceType       String    @default("MANUAL") // MANUAL, SKU, ITEM_UNIT
  sourceSkuId      String?
  sourceItemUnitId String?
  availableQty     Decimal   @default(0) @db.Decimal(19, 4)
  reservedQty      Decimal   @default(0) @db.Decimal(19, 4)
  unitPrice        Decimal?  @db.Decimal(19, 4)
  currency         String?
  commissionRate   Decimal?  @db.Decimal(8, 4)
  fulfillmentMode  String    @default("SUPPLIER_SHIPS") // SUPPLIER_SHIPS, PLATFORM_SHIPS, SELF_PICKUP
  shipFromLocation String?
  etaDays          Int?
  minOrderQty      Decimal?  @db.Decimal(19, 4)
  maxOrderQty      Decimal?  @db.Decimal(19, 4)
  publishedAt      DateTime?
  pausedAt         DateTime?
  createdById      String?
  updatedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ownerPartner        Partner?             @relation("SupplyOfferOwnerPartner", fields: [ownerPartnerId], references: [id], onDelete: SetNull)
  sourceSku           SKU?                 @relation(fields: [sourceSkuId], references: [id], onDelete: SetNull)
  sourceItemUnit      ItemUnit?            @relation(fields: [sourceItemUnitId], references: [id], onDelete: SetNull)
  items               SupplyOfferItem[]
  visibilityRules     OfferVisibility[]
  resaleListings      ResaleListing[]
  supplyReservations  SupplyReservation[]
  fulfillmentRequests FulfillmentRequest[]

  @@index([storeId])
  @@index([ownerPartnerId])
  @@index([sourceSkuId])
  @@index([sourceItemUnitId])
  @@index([status])
  @@index([visibility])
  @@map("supply_offers")
}

model ResaleListing {
  id                   String    @id @default(cuid())
  storeId              String
  supplyOfferId        String
  platformId           String
  listingId            String?
  title                String
  externalListingNo    String?
  targetPrice          Decimal   @db.Decimal(19, 4)
  currency             String
  quantityPlanned      Decimal   @default(1) @db.Decimal(19, 4)
  quantitySold         Decimal   @default(0) @db.Decimal(19, 4)
  supplyUnitPrice      Decimal?  @db.Decimal(19, 4)
  supplyCurrency       String?
  commissionRate       Decimal?  @db.Decimal(8, 4)
  platformFeeRate      Decimal?  @db.Decimal(8, 4)
  estimatedPlatformFee Decimal?  @db.Decimal(19, 4)
  estimatedCommission  Decimal?  @db.Decimal(19, 4)
  estimatedGrossProfit Decimal?  @db.Decimal(19, 4)
  fulfillmentMode      String    @default("SUPPLIER_SHIPS")
  status               String    @default("DRAFT") // DRAFT, ACTIVE, PAUSED, SOLD_OUT, DELISTED
  listedAt             DateTime?
  pausedAt             DateTime?
  delistedAt           DateTime?
  notes                String?   @db.Text
  createdById          String?
  updatedById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplyOffer         SupplyOffer          @relation(fields: [supplyOfferId], references: [id], onDelete: Cascade)
  platform            Platform             @relation(fields: [platformId], references: [id], onDelete: Cascade)
  listing             Listing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reservations        SupplyReservation[]
  fulfillmentRequests FulfillmentRequest[]
  customerOrders      CustomerOrder[]

  @@index([storeId])
  @@index([supplyOfferId])
  @@index([platformId])
  @@index([listingId])
  @@index([status])
  @@map("resale_listings")
}

model SupplyReservation {
  id              String    @id @default(cuid())
  storeId         String
  supplyOfferId   String
  resaleListingId String?
  quantity        Decimal   @db.Decimal(19, 4)
  status          String    @default("ACTIVE") // ACTIVE, RELEASED, CONSUMED, CANCELLED
  reason          String    @default("FULFILLMENT_REQUEST")
  note            String?   @db.Text
  createdById     String?
  releasedAt      DateTime?
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplyOffer         SupplyOffer          @relation(fields: [supplyOfferId], references: [id], onDelete: Cascade)
  resaleListing       ResaleListing?       @relation(fields: [resaleListingId], references: [id], onDelete: SetNull)
  fulfillmentRequests FulfillmentRequest[]
  listing             Listing?             @relation(fields: [listingId], references: [id])
  listingId           String?

  @@index([storeId])
  @@index([supplyOfferId])
  @@index([resaleListingId])
  @@index([status])
  @@map("supply_reservations")
}

model FulfillmentRequest {
  id               String    @id @default(cuid())
  storeId          String
  supplyOfferId    String
  resaleListingId  String?
  reservationId    String?
  customerOrderId  String?
  requestNo        String
  quantity         Decimal   @db.Decimal(19, 4)
  status           String    @default("REQUESTED") // REQUESTED, ACCEPTED, REJECTED, SHIPPED, DELIVERED, CANCELLED, EXCEPTION
  recipientName    String
  recipientPhone   String?
  shippingAddress  String    @db.Text
  shippingCountry  String?
  carrier          String?
  trackingNo       String?
  shippingFee      Decimal?  @db.Decimal(19, 4)
  shippingCurrency String?
  requestedAt      DateTime  @default(now())
  acceptedAt       DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  note             String?   @db.Text
  createdById      String?
  updatedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplyOffer   SupplyOffer        @relation(fields: [supplyOfferId], references: [id], onDelete: Cascade)
  resaleListing ResaleListing?     @relation(fields: [resaleListingId], references: [id], onDelete: SetNull)
  reservation   SupplyReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  customerOrder CustomerOrder?     @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)
  settlements   Settlement[]
  listing       Listing?           @relation(fields: [listingId], references: [id])
  listingId     String?

  @@unique([storeId, requestNo])
  @@index([storeId])
  @@index([supplyOfferId])
  @@index([resaleListingId])
  @@index([reservationId])
  @@index([customerOrderId])
  @@index([status])
  @@map("fulfillment_requests")
}

model Settlement {
  id                   String    @id @default(cuid())
  storeId              String
  partnerId            String?
  fulfillmentRequestId String?
  customerOrderId      String?
  settlementNo         String
  direction            String    @default("PAYABLE") // PAYABLE, RECEIVABLE, MIXED
  status               String    @default("DRAFT") // DRAFT, CONFIRMED, PAID, VOID
  currency             String
  totalAmount          Decimal   @default(0) @db.Decimal(19, 4)
  baseCurrency         String?
  fxRate               Decimal?  @db.Decimal(19, 8)
  baseAmount           Decimal?  @db.Decimal(19, 4)
  periodStart          DateTime?
  periodEnd            DateTime?
  confirmedAt          DateTime?
  paidAt               DateTime?
  voidedAt             DateTime?
  note                 String?   @db.Text
  createdById          String?
  updatedById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  partner            Partner?            @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  fulfillmentRequest FulfillmentRequest? @relation(fields: [fulfillmentRequestId], references: [id], onDelete: SetNull)
  customerOrder      CustomerOrder?      @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)
  lines              SettlementLine[]

  @@unique([storeId, settlementNo])
  @@index([storeId])
  @@index([partnerId])
  @@index([fulfillmentRequestId])
  @@index([customerOrderId])
  @@index([status])
  @@map("settlements")
}

model SettlementLine {
  id           String   @id @default(cuid())
  settlementId String
  lineType     String // SUPPLY_COST, COMMISSION, PLATFORM_FEE, FULFILLMENT_FEE, SHIPPING_FEE, ADJUSTMENT
  description  String
  amount       Decimal  @db.Decimal(19, 4)
  currency     String
  direction    String   @default("PAYABLE") // PAYABLE, RECEIVABLE
  sourceType   String?
  sourceId     String?
  baseCurrency String?
  fxRate       Decimal? @db.Decimal(19, 8)
  baseAmount   Decimal? @db.Decimal(19, 4)
  createdAt    DateTime @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@index([lineType])
  @@index([sourceType, sourceId])
  @@map("settlement_lines")
}

model SupplyOfferItem {
  id                String   @id @default(cuid())
  offerId           String
  skuId             String?
  itemUnitId        String?
  title             String
  variantCode       String?
  quantityAvailable Decimal  @db.Decimal(19, 4)
  quantityReserved  Decimal  @default(0) @db.Decimal(19, 4)
  unitPrice         Decimal? @db.Decimal(19, 4)
  currency          String?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  offer    SupplyOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sku      SKU?        @relation(fields: [skuId], references: [id], onDelete: SetNull)
  itemUnit ItemUnit?   @relation(fields: [itemUnitId], references: [id], onDelete: SetNull)

  @@index([offerId])
  @@index([skuId])
  @@index([itemUnitId])
  @@map("supply_offer_items")
}

model OfferVisibility {
  id            String   @id @default(cuid())
  offerId       String
  partnerId     String?
  viewerStoreId String?
  scope         String   @default("PARTNER") // PARTNER, STORE
  createdAt     DateTime @default(now())

  offer       SupplyOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  partner     Partner?    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  viewerStore Store?      @relation("OfferVisibilityStore", fields: [viewerStoreId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([partnerId])
  @@index([viewerStoreId])
  @@map("offer_visibility")
}

// ============================================
// FX: Exchange Rates
// ============================================

model FxRate {
  id            String   @id @default(cuid())
  fromCurrency  String
  toCurrency    String
  rate          Decimal  @db.Decimal(19, 8)
  effectiveDate DateTime
  createdAt     DateTime @default(now())

  @@index([fromCurrency, toCurrency, effectiveDate])
  @@map("fx_rates")
}

// ============================================
// IMPORT: Batch Import Jobs
// ============================================

model ImportJob {
  id          String   @id @default(cuid())
  storeId     String
  entityType  String // SKU, INVENTORY_LOT, PURCHASE_LINE, CUSTOMER_ORDER, LISTING
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  totalRows   Int      @default(0)
  successRows Int      @default(0)
  failedRows  Int      @default(0)
  errorReport Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([entityType])
  @@map("import_jobs")
}

// ============================================
// LOGISTICS: Inbound shipments, consolidation, inspection
// ============================================

model InboundShipment {
  id              String    @id @default(cuid())
  storeId         String
  purchaseOrderId String?
  legIndex        Int       @default(1)
  fromLocationId  String?
  toLocationId    String?
  trackingNo      String?
  carrier         String?
  shippedAt       DateTime?
  etaDate         DateTime?
  receivedAt      DateTime?
  status          String    @default("PENDING") // PENDING, IN_TRANSIT, DELIVERED, EXCEPTION
  shipmentNote    String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  fromLocation  Location?      @relation("ShipmentFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation    Location?      @relation("ShipmentTo", fields: [toLocationId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([purchaseOrderId])
  @@index([status])
  @@map("inbound_shipments")
}

model ConsolidationBatch {
  id                 String    @id @default(cuid())
  storeId            String
  fromLocationId     String?
  toLocationId       String?
  status             String    @default("OPEN") // OPEN, SEALED, SHIPPED, RECEIVED
  outboundTrackingNo String?
  carrier            String?
  shippedAt          DateTime?
  receivedAt         DateTime?
  note               String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  store        Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fromLocation Location?                @relation("ConsolidationFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location?                @relation("ConsolidationTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  lines        ConsolidationBatchLine[]

  @@index([storeId])
  @@index([status])
  @@map("consolidation_batches")
}

model ConsolidationBatchLine {
  id         String  @id @default(cuid())
  batchId    String
  sourceType String // PURCHASE_LINE, LOT, ITEM_UNIT, QUICK_ENTRY
  sourceId   String
  quantity   Decimal @db.Decimal(19, 4)

  batch ConsolidationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("consolidation_batch_lines")
}

model InspectionEvent {
  id            String   @id @default(cuid())
  storeId       String
  refType       String // QUICK_ENTRY, PURCHASE_LINE, ITEM_UNIT, INBOUND_SHIPMENT
  refId         String
  locationId    String?
  result        String // PASSED, FAILED, PARTIAL
  failureReason String?  @db.Text
  photos        Json?
  inspectedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([refType, refId])
  @@map("inspection_events")
}

// ============================================
// QUICK ENTRY: Excel-style capture + async structure
// ============================================

model QuickEntry {
  id         String @id @default(cuid())
  storeId    String
  sourceType String @default("MANUAL") // MANUAL, PASTE, IMPORT

  rawBrand             String?
  rawProductName       String
  rawVariant           String?
  rawCategory          String?
  conditionType        String? // 新品, 中古
  quantity             Decimal   @default(1) @db.Decimal(19, 4)
  purchasePrice        Decimal?  @db.Decimal(19, 4)
  purchaseCurrency     String?
  purchasePlatformText String?
  purchaseDate         DateTime?
  purchaseTrackingNo   String?
  purchaseShippingFee  Decimal?  @db.Decimal(19, 4)
  currentLocationText  String?
  transitTrackingNo    String?
  transitShippingFee   Decimal?  @db.Decimal(19, 4)
  listingPlatformsText String?
  salePlatformText     String?
  saleCurrency         String?
  salePrice            Decimal?  @db.Decimal(19, 4)
  saleShippingFee      Decimal?  @db.Decimal(19, 4)
  saleMiscFee          Decimal?  @db.Decimal(19, 4)
  salePlatformFeeText  String?
  saleDate             DateTime?
  note                 String?   @db.Text
  batchNote            String?

  workflowStage    String    @default("PURCHASE") // PURCHASE, LOGISTICS, INSPECTION, LISTING, SOLD, SHIPPED, SETTLED, CLOSED
  inspectionResult String? // PASSED, FAILED, PENDING
  inspectionNote   String?   @db.Text
  inspectedAt      DateTime?

  processedStatus String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, PARTIAL, FAILED
  processedAt     DateTime?
  errorMessage    String?   @db.Text

  generatedSkuId           String?
  generatedLotId           String?
  generatedItemUnitIds     Json?
  generatedPurchaseOrderId String?
  generatedPurchaseLineId  String?
  generatedListingIds      Json?
  generatedCustomerOrderId String?
  generatedOrderLineId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([processedStatus])
  @@index([workflowStage])
  @@index([createdAt])
  @@map("quick_entries")
}
