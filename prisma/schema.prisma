  storeId          String
  inventoryPoolId  String?
  splitType        String // UNBOX, DISASSEMBLE, CUSTOM
  sourceType       String // LOT, ITEM_UNIT
  sourceId         String
  occurredAt       DateTime @default(now())
  totalSourceCost  Decimal  @db.Decimal(19, 4)
  allocationMethod String   @default("PROPORTIONAL_BY_QTY")
  createdById      String?
  createdAt        DateTime @default(now())

  store Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lines InventorySplitLine[]

  @@index([storeId])
  @@index([inventoryPoolId])
  @@index([sourceType, sourceId])
  @@map("inventory_splits")
}

model InventorySplitLine {
  id            String  @id @default(cuid())
  splitId       String
  targetType    String // LOT, ITEM_UNIT
  targetId      String
  quantity      Decimal @db.Decimal(19, 4)
  allocatedCost Decimal @db.Decimal(19, 4)

  split InventorySplit @relation(fields: [splitId], references: [id], onDelete: Cascade)

  @@index([splitId])
  @@map("inventory_split_lines")
}

// ============================================
// PROCUREMENT: Purchase Orders
// ============================================

model PurchaseOrder {
  id                    String    @id @default(cuid())
  storeId               String
  inventoryPoolId       String?
  orderNo               String
  supplierId            String?
  supplierName          String?
  currency              String
  fxRate                Decimal?  @db.Decimal(19, 8)
  subtotal              Decimal   @db.Decimal(19, 4)
  totalAmount           Decimal   @db.Decimal(19, 4)
  declaredTotalAmount   Decimal?  @db.Decimal(19, 4)
  costAllocationStatus  String    @default("ALLOCATED") // PENDING, ALLOCATED
  costAllocationMethod  String? // BY_QUANTITY, BY_AMOUNT, MANUAL
  costAllocatedAt       DateTime?
  status                String    @default("DRAFT") // DRAFT, ORDERED, SHIPPED, RECEIVED, CANCELLED
  orderedAt             DateTime?
  shippedAt             DateTime?
  etaDate               DateTime?
  receivedAt            DateTime?
  trackingNo            String?
  carrier               String?
  shipmentNote          String?   @db.Text
  destinationLocationId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  store               Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  destinationLocation Location?         @relation(fields: [destinationLocationId], references: [id], onDelete: SetNull)
  supplier            Partner?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lines               PurchaseLine[]
  inboundShipments    InboundShipment[]

  @@unique([storeId, orderNo])
  @@index([storeId])
  @@index([inventoryPoolId])
  @@index([supplierId])
  @@index([costAllocationStatus])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseLine {
  id                String   @id @default(cuid())
  purchaseOrderId   String
  skuId             String
  trackingMode      String   @default("LOT") // LOT, ITEM_UNIT
  quantity          Decimal  @db.Decimal(19, 4)
  unitPrice         Decimal  @db.Decimal(19, 4)
  lineAmount        Decimal  @db.Decimal(19, 4)
  allocatedFee      Decimal  @default(0) @db.Decimal(19, 4)
  allocatedDiscount Decimal  @default(0) @db.Decimal(19, 4)
  costStatus        String   @default("ALLOCATED") // PENDING, ALLOCATED
  costTrace         Json?
  forOrderLineId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sku           SKU           @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([skuId])
  @@index([trackingMode])
  @@index([costStatus])
  @@map("purchase_lines")
}

// ============================================
// SALES: Customer Orders
// ============================================

model CustomerOrder {
  id                       String    @id @default(cuid())
  storeId                  String
  salesChannelAccountId    String?
  requestPayloadHash       String? // Canonical hash used to reject idempotency-key payload drift
  orderNumber              String    @unique
  platformId               String?
  resaleListingId          String?
  externalOrderNo          String?
  customerName             String
  customerEmail            String?
  customerPhone            String?
  shippingAddress          String?   @db.Text
  shippingCountry          String? // CN, JP, US, EU; fulfillment source of truth
  orderDate                DateTime
  currency                 String
  subtotal                 Decimal   @db.Decimal(19, 4)
  discountTotal            Decimal   @default(0) @db.Decimal(19, 4)
  shippingCharged          Decimal   @default(0) @db.Decimal(19, 4)
  totalPaid                Decimal   @db.Decimal(19, 4)
  platformFee              Decimal   @default(0) @db.Decimal(19, 4)
  shippingFee              Decimal   @default(0) @db.Decimal(19, 4)
  shippingFeeStatus        String    @default("PENDING") // PENDING, ESTIMATED, ACTUAL
  shippingProvider         String?
  shippingProviderFeeRate  Decimal?  @db.Decimal(8, 4)
  netRevenue               Decimal?  @db.Decimal(19, 4)
  countryFlow              String?
  orderStatus              String    @default("DRAFT") // DRAFT, PLACED, PAID, CONFIRMED, SHIPPED, DELIVERED, RETURNED, CANCELLED
  shippedAt                DateTime?
  trackingNo               String?
  shippingProof            Json?
  settledAt                DateTime?
  settlementFxRate         Decimal?  @db.Decimal(19, 8)
  settlementBaseCurrency   String?
  settlementNetRevenueBase Decimal?  @db.Decimal(19, 4)
  createdAt                DateTime  @default(now())
  confirmedAt              DateTime?
  updatedAt                DateTime  @updatedAt

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform            Platform?            @relation(fields: [platformId], references: [id])
  resaleListing       ResaleListing?       @relation(fields: [resaleListingId], references: [id], onDelete: SetNull)
  lines               OrderLine[]
  fulfillmentRequests FulfillmentRequest[]
  settlements         Settlement[]
  salesChannelAccount SalesChannelAccount? @relation(fields: [salesChannelAccountId], references: [id], onDelete: SetNull)
  afterSalesCases     AfterSalesCase[]

  @@index([storeId])
  @@index([salesChannelAccountId])
  @@index([orderStatus])
  @@index([platformId])
  @@index([resaleListingId])
  @@map("customer_orders")
}

model OrderLine {
  id                String   @id @default(cuid())
  orderId           String
  skuId             String
  quantity          Decimal  @db.Decimal(19, 4)
  unitPrice         Decimal? @db.Decimal(19, 4)
  lineAmount        Decimal  @db.Decimal(19, 4)
  allocatedDiscount Decimal  @default(0) @db.Decimal(19, 4)
  allocatedFee      Decimal  @default(0) @db.Decimal(19, 4)
  supplyType        String   @default("FROM_STOCK") // FROM_STOCK, PURCHASE_FOR_ORDER
  supplyStatus      String   @default("UNFULFILLED") // UNFULFILLED, ALLOCATED_FROM_STOCK, PURCHASE_REQUESTED, PURCHASED_INBOUND, READY_TO_SHIP, CONSUMED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order           CustomerOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku             SKU               @relation(fields: [skuId], references: [id], onDelete: Cascade)
  allocations     OrderAllocation[]
  afterSalesLines AfterSalesLine[]

  @@index([orderId])
  @@index([skuId])
  @@map("order_lines")
}

model OrderAllocation {
  id             String   @id @default(cuid())
  orderLineId    String
  allocationType String // LOT, ITEM_UNIT
  lotId          String?
  itemUnitId     String?
  quantity       Decimal  @db.Decimal(19, 4)
  unitCost       Decimal  @db.Decimal(19, 4)
  costAmount     Decimal  @db.Decimal(19, 4)
  costCurrency   String?
  costFxRate     Decimal? @db.Decimal(19, 8)
  costBaseAmount Decimal? @db.Decimal(19, 4)
  costSourceType String?
  costSourceId   String?
  status         String   @default("PENDING") // PENDING, ALLOCATED, SHIPPED, DELIVERED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderLine    OrderLine     @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  inventoryLot InventoryLot? @relation(fields: [lotId], references: [id], onDelete: Cascade)
  itemUnit     ItemUnit?     @relation(fields: [itemUnitId], references: [id], onDelete: Cascade)

  @@index([orderLineId])
  @@index([lotId])
  @@index([itemUnitId])
  @@map("order_allocations")
}

// ============================================
// SHARED: Fee
// ============================================

model Fee {
  id               String  @id @default(cuid())
  refType          String // PURCHASE_ORDER, CUSTOMER_ORDER, ORDER_LINE
  refId            String
  feeType          String // DISCOUNT, PLATFORM_FEE, SHIPPING_COST, PACKING_FEE, TAX
  amount           Decimal @db.Decimal(19, 4)
  currency         String
  allocationMethod String  @default("PROPORTIONAL_BY_AMOUNT")
  allocationBasis  String? // AMOUNT, QTY, WEIGHT

  @@index([refType, refId])
  @@map("fees")
}

// ============================================
// LISTING: Platforms & Listings
// ============================================

model Platform {
  id                 String   @id @default(cuid())
  storeId            String
  code               String
  name               String
  country            String?
  defaultFeeRate     Decimal? @db.Decimal(8, 4)
  defaultCurrency    String?
  defaultShippingFee Decimal? @db.Decimal(19, 4)
  shippingRules      Json?
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  listings            Listing[]
  resaleListings      ResaleListing[]
  customerOrders      CustomerOrder[]
  salesChannelAccount SalesChannelAccount?

  @@unique([storeId, code])
  @@index([storeId])
  @@map("platforms")
}

model Listing {
  id                    String    @id @default(cuid())
  storeId               String
  salesChannelAccountId String?
  platformId            String
  skuId                 String?
  itemUnitId            String?
  listingType           String // SKU, ITEM_UNIT
  listedPrice           Decimal?  @db.Decimal(19, 4)
  currency              String?
  feeRateOverride       Decimal?  @db.Decimal(8, 4)
  shippingFeeOverride   Decimal?  @db.Decimal(19, 4)
  estimatedNet          Decimal?  @db.Decimal(19, 4)
  status                String    @default("ACTIVE") // ACTIVE, DELISTED
  listedAt              DateTime  @default(now())
  delistedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platform            Platform             @relation(fields: [platformId], references: [id], onDelete: Cascade)
  sku                 SKU?                 @relation(fields: [skuId], references: [id], onDelete: Cascade)
  itemUnit            ItemUnit?            @relation(fields: [itemUnitId], references: [id], onDelete: Cascade)
  resaleListings      ResaleListing[]
  reservations        SupplyReservation[]
  fulfillmentRequests FulfillmentRequest[]
  salesChannelAccount SalesChannelAccount? @relation(fields: [salesChannelAccountId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([salesChannelAccountId])
  @@index([platformId])
  @@index([skuId])
  @@index([itemUnitId])
  @@index([status])
  @@map("listings")
}

// ============================================
// MARKETPLACE: Partners & supply offers
// ============================================

model Partner {
  id              String   @id @default(cuid())
  storeId         String
  organizationId  String?
  code            String
  name            String
  type            String   @default("SUPPLIER") // SUPPLIER, RESELLER, FULFILLER, CHANNEL, OTHER
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  defaultCurrency String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store                   Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization            Organization?            @relation("PartnerOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  tradingRelationships    TradingRelationship[]
  ownedSupplyOffers       SupplyOffer[]            @relation("SupplyOfferOwnerPartner")
  visibilityRules         OfferVisibility[]
  settlements             Settlement[]
  supplyOfferChannels     SupplyOfferChannel[]
  purchaseOrders          PurchaseOrder[]
  organizationConnections OrganizationConnection[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([organizationId])
  @@index([status])
  @@map("partners")
}

model OrganizationConnection {
  id                      String    @id @default(cuid())
  requesterOrganizationId String
  targetOrganizationId    String
  initiatingPartnerId     String?
  pairKey                 String    @unique
  status                  String    @default("PENDING") // PENDING, ACTIVE, REJECTED, ENDED
  requestedById           String
  respondedById           String?
  respondedAt             DateTime?
  endedAt                 DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  requesterOrganization Organization                  @relation("OrganizationConnectionRequester", fields: [requesterOrganizationId], references: [id], onDelete: Restrict)
  targetOrganization    Organization                  @relation("OrganizationConnectionTarget", fields: [targetOrganizationId], references: [id], onDelete: Restrict)
  initiatingPartner     Partner?                      @relation(fields: [initiatingPartnerId], references: [id], onDelete: SetNull)
  requestedBy           User                          @relation("OrganizationConnectionRequesterUser", fields: [requestedById], references: [id], onDelete: Restrict)
  respondedBy           User?                         @relation("OrganizationConnectionResponderUser", fields: [respondedById], references: [id], onDelete: SetNull)
  offerVisibilityRules  OfferVisibility[]
  events                OrganizationConnectionEvent[]

  @@index([requesterOrganizationId, status])
  @@index([targetOrganizationId, status])
  @@index([initiatingPartnerId])
  @@map("organization_connections")
}

model OrganizationConnectionEvent {
  id           String   @id @default(cuid())
  connectionId String
  eventType    String // REQUESTED, ACCEPTED, REJECTED, ENDED, REOPENED
  actorUserId  String
  fromStatus   String?
  toStatus     String
  reason       String?  @db.Text
  metadata     Json?
  createdAt    DateTime @default(now())

  connection OrganizationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  actorUser  User                   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([connectionId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
  @@map("organization_connection_events")
}

model TradingRelationship {
  id                 String   @id @default(cuid())
  storeId            String
  partnerId          String
  relationshipType   String   @default("SUPPLY") // SUPPLY, RESELL, FULFILLMENT, CHANNEL
  visibilityScope    String   @default("PRIVATE") // PRIVATE, PARTNER_ONLY, PUBLIC
  status             String   @default("ACTIVE") // ACTIVE, INACTIVE
  commissionRate     Decimal? @db.Decimal(8, 4)
  serviceFeeRate     Decimal? @db.Decimal(8, 4)
  settlementCurrency String?
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([storeId, partnerId, relationshipType])
  @@index([storeId])
  @@index([partnerId])
  @@index([status])
  @@map("trading_relationships")
}

model SupplyOffer {
  id                     String    @id @default(cuid())
  storeId                String
  organizationId         String?
  inventoryPoolId        String?
  providerOrganizationId String?
  ownerPartnerId         String?
  title                  String
  description            String?   @db.Text
  visibility             String    @default("PRIVATE") // PRIVATE, PARTNER_ONLY, PUBLIC
  status                 String    @default("DRAFT") // DRAFT, PUBLISHED, PAUSED, DELISTED
  sourceType             String    @default("MANUAL") // MANUAL, SKU, ITEM_UNIT
  sourceSkuId            String?
  sourceItemUnitId       String?
  inventoryPolicy        String    @default("SHARED_POOL") // Offer-level stock is shared; per-channel guarantees live on SupplyOfferChannel
  publishedQty           Decimal   @default(0) @db.Decimal(19, 4)
  availableQty           Decimal   @default(0) @db.Decimal(19, 4)
  reservedQty            Decimal   @default(0) @db.Decimal(19, 4)
  fulfilledQty           Decimal   @default(0) @db.Decimal(19, 4)
  safetyStockQty         Decimal   @default(0) @db.Decimal(19, 4)
  unitPrice              Decimal?  @db.Decimal(19, 4)
  currency               String?
  settlementCurrency     String?
  commissionType         String    @default("MARGIN") // MARGIN, PERCENT, FIXED, HYBRID
  commissionRate         Decimal?  @db.Decimal(8, 4)
  commissionFixedAmount  Decimal?  @db.Decimal(19, 4)
  dropshipFee            Decimal?  @db.Decimal(19, 4)
  dropshipFeeCurrency    String?
  agreementTerms         String?   @db.Text
  agreementRule          Json?
  agreementVersion       Int       @default(1)
  agreementStatus        String    @default("DRAFT") // DRAFT, CONFIRMED
  agreementConfirmedAt   DateTime?
  fulfillmentMode        String    @default("SUPPLIER_SHIPS") // SUPPLIER_SHIPS, PLATFORM_SHIPS, SELF_PICKUP
  shipFromLocation       String?
  etaDays                Int?
  minOrderQty            Decimal?  @db.Decimal(19, 4)
  maxOrderQty            Decimal?  @db.Decimal(19, 4)
  publishedAt            DateTime?
  pausedAt               DateTime?
  createdById            String?
  updatedById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  store                Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  organization         Organization?        @relation("SupplyOfferOwnerOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  inventoryPool        InventoryPool?       @relation(fields: [inventoryPoolId], references: [id], onDelete: SetNull)
  providerOrganization Organization?        @relation("SupplyOfferProviderOrganization", fields: [providerOrganizationId], references: [id], onDelete: SetNull)
  ownerPartner         Partner?             @relation("SupplyOfferOwnerPartner", fields: [ownerPartnerId], references: [id], onDelete: SetNull)
  sourceSku            SKU?                 @relation(fields: [sourceSkuId], references: [id], onDelete: SetNull)
  sourceItemUnit       ItemUnit?            @relation(fields: [sourceItemUnitId], references: [id], onDelete: SetNull)
  items                SupplyOfferItem[]
  visibilityRules      OfferVisibility[]
  resaleListings       ResaleListing[]
  supplyReservations   SupplyReservation[]
  fulfillmentRequests  FulfillmentRequest[]
  salesChannels        SupplyOfferChannel[]

  @@index([storeId])
  @@index([organizationId])
  @@index([inventoryPoolId])
  @@index([providerOrganizationId])
  @@index([ownerPartnerId])
  @@index([sourceSkuId])
  @@index([sourceItemUnitId])
  @@index([status])
  @@index([visibility])
  @@map("supply_offers")
}

model ResaleListing {
  id                     String    @id @default(cuid())
  storeId                String
  salesChannelAccountId  String?
  sellerOrganizationId   String?
  supplyOfferChannelId   String?
  supplyOfferId          String
  supplyOfferItemId      String?
  platformId             String
  listingId              String?
  title                  String
  externalListingNo      String?
  idempotencyKey         String?
  targetPrice            Decimal   @db.Decimal(19, 4)
  currency               String
  quantityPlanned        Decimal   @default(1) @db.Decimal(19, 4)
  quantitySold           Decimal   @default(0) @db.Decimal(19, 4)
  supplyUnitPrice        Decimal?  @db.Decimal(19, 4)
  supplyCurrency         String?
  commissionRate         Decimal?  @db.Decimal(8, 4)
  commissionType         String    @default("MARGIN") // MARGIN, PERCENT, FIXED, HYBRID
  commissionFixedAmount  Decimal?  @db.Decimal(19, 4)
  dropshipFee            Decimal?  @db.Decimal(19, 4)
  dropshipFeeCurrency    String?
  agreementTermsSnapshot String?   @db.Text
  agreementRuleSnapshot  Json?
  agreementVersion       Int?
  agreementAcceptedAt    DateTime?
  platformFeeRate        Decimal?  @db.Decimal(8, 4)
  estimatedPlatformFee   Decimal?  @db.Decimal(19, 4)
  estimatedCommission    Decimal?  @db.Decimal(19, 4)
  estimatedGrossProfit   Decimal?  @db.Decimal(19, 4)
  fulfillmentMode        String    @default("SUPPLIER_SHIPS")
  status                 String    @default("DRAFT") // DRAFT, ACTIVE, PAUSED, SOLD_OUT, DELISTED
  listedAt               DateTime?
  pausedAt               DateTime?
  delistedAt             DateTime?
  notes                  String?   @db.Text
  createdById            String?
  updatedById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplyOffer         SupplyOffer          @relation(fields: [supplyOfferId], references: [id], onDelete: Cascade)
  supplyOfferItem     SupplyOfferItem?     @relation(fields: [supplyOfferItemId], references: [id], onDelete: SetNull)
  platform            Platform             @relation(fields: [platformId], references: [id], onDelete: Cascade)
  listing             Listing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reservations        SupplyReservation[]
  fulfillmentRequests FulfillmentRequest[]
  customerOrders      CustomerOrder[]
  salesChannelAccount SalesChannelAccount? @relation(fields: [salesChannelAccountId], references: [id], onDelete: SetNull)
  supplyOfferChannel  SupplyOfferChannel?  @relation(fields: [supplyOfferChannelId], references: [id], onDelete: SetNull)

  @@unique([sellerOrganizationId, idempotencyKey])
  @@index([storeId])
  @@index([salesChannelAccountId])
  @@index([sellerOrganizationId])
  @@index([supplyOfferChannelId])
  @@index([supplyOfferId])
  @@index([supplyOfferItemId])
  @@index([platformId])
  @@index([listingId])
  @@index([status])
  @@map("resale_listings")
}

model SupplyReservation {
  id                   String    @id @default(cuid())
  storeId              String
  supplyOfferId        String
  supplyOfferItemId    String?
  supplyOfferChannelId String?
  resaleListingId      String?
  quantity             Decimal   @db.Decimal(19, 4)
  status               String    @default("ACTIVE") // ACTIVE, RELEASED, CONSUMED, CANCELLED
  reason               String    @default("FULFILLMENT_REQUEST")
  note                 String?   @db.Text
  createdById          String?
  releasedAt           DateTime?
  consumedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplyOffer         SupplyOffer          @relation(fields: [supplyOfferId], references: [id], onDelete: Cascade)
  supplyOfferItem     SupplyOfferItem?     @relation(fields: [supplyOfferItemId], references: [id], onDelete: SetNull)
  resaleListing       ResaleListing?       @relation(fields: [resaleListingId], references: [id], onDelete: SetNull)
  supplyOfferChannel  SupplyOfferChannel?  @relation(fields: [supplyOfferChannelId], references: [id], onDelete: SetNull)
  fulfillmentRequests FulfillmentRequest[]
  listing             Listing?             @relation(fields: [listingId], references: [id])
  listingId           String?

  @@index([storeId])
  @@index([supplyOfferId])
  @@index([supplyOfferItemId])
  @@index([resaleListingId])
  @@index([supplyOfferChannelId])
  @@index([status])
  @@map("supply_reservations")
}

model FulfillmentRequest {
  id                      String    @id @default(cuid())
  storeId                 String
  requesterOrganizationId String?
  providerOrganizationId  String?
  inventoryPoolId         String?
  fulfillmentLocationId   String?
  assignedToId            String?
  idempotencyKey          String?
  supplyOfferId           String
  resaleListingId         String?
  reservationId           String?
  customerOrderId         String?
  requestNo               String
  quantity                Decimal   @db.Decimal(19, 4)
  status                  String    @default("REQUESTED") // REQUESTED, ACCEPTED, REJECTED, SHIPPED, DELIVERED, CANCELLED, EXCEPTION
  recipientName           String
  recipientPhone          String?
  shippingAddress         String    @db.Text
  shippingCountry         String?
  carrier                 String?
  trackingNo              String?
  shippingProof           Json?
  shippingFee             Decimal?  @db.Decimal(19, 4)
  shippingCurrency        String?
  requestedAt             DateTime  @default(now())
  acceptedAt              DateTime?
  shippedAt               DateTime?
  deliveredAt             DateTime?
  cancelledAt             DateTime?
  note                    String?   @db.Text
  createdById             String?
  updatedById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  store                Store                            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplyOffer          SupplyOffer                      @relation(fields: [supplyOfferId], references: [id], onDelete: Cascade)
  resaleListing        ResaleListing?                   @relation(fields: [resaleListingId], references: [id], onDelete: SetNull)
  reservation          SupplyReservation?               @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  customerOrder        CustomerOrder?                   @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)
  settlements          Settlement[]
  inventoryAllocations FulfillmentInventoryAllocation[]
  listing              Listing?                         @relation(fields: [listingId], references: [id])
  listingId            String?

  @@unique([storeId, requestNo])
  @@unique([requesterOrganizationId, idempotencyKey])
  @@index([storeId])
  @@index([requesterOrganizationId])
  @@index([providerOrganizationId])
  @@index([inventoryPoolId])
  @@index([fulfillmentLocationId])
  @@index([assignedToId])
  @@index([supplyOfferId])
  @@index([resaleListingId])
  @@index([reservationId])
  @@index([customerOrderId])
  @@index([status])
  @@map("fulfillment_requests")
}

model Settlement {
  id                     String    @id @default(cuid())
  storeId                String
  payerOrganizationId    String?
  payeeOrganizationId    String?
  partnerId              String?
  fulfillmentRequestId   String?
  customerOrderId        String?
  settlementNo           String
  direction              String    @default("PAYABLE") // PAYABLE, RECEIVABLE, MIXED
  status                 String    @default("DRAFT") // DRAFT, CONFIRMED, PAID, VOID
  currency               String
  totalAmount            Decimal   @default(0) @db.Decimal(19, 4)
  baseCurrency           String?
  fxRate                 Decimal?  @db.Decimal(19, 8)
  baseAmount             Decimal?  @db.Decimal(19, 4)
  periodStart            DateTime?
  periodEnd              DateTime?
  confirmedAt            DateTime?
  paidAt                 DateTime?
  voidedAt               DateTime?
  note                   String?   @db.Text
  agreementTermsSnapshot String?   @db.Text
  agreementRuleSnapshot  Json?
  agreementVersion       Int?
  createdById            String?
  updatedById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  partner            Partner?            @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  fulfillmentRequest FulfillmentRequest? @relation(fields: [fulfillmentRequestId], references: [id], onDelete: SetNull)
  customerOrder      CustomerOrder?      @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)
  lines              SettlementLine[]
  items              SettlementItem[]

  @@unique([storeId, settlementNo])
  @@index([storeId])
  @@index([payerOrganizationId])
  @@index([payeeOrganizationId])
  @@index([partnerId])
  @@index([fulfillmentRequestId])
  @@index([customerOrderId])
  @@index([status])
  @@map("settlements")
}

model SettlementLine {
  id           String   @id @default(cuid())
  settlementId String
  lineType     String // SUPPLY_COST, COMMISSION, PLATFORM_FEE, FULFILLMENT_FEE, SHIPPING_FEE, ADJUSTMENT
  description  String
  amount       Decimal  @db.Decimal(19, 4)
  currency     String
  direction    String   @default("PAYABLE") // PAYABLE, RECEIVABLE
  sourceType   String?
  sourceId     String?
  baseCurrency String?
  fxRate       Decimal? @db.Decimal(19, 8)
  baseAmount   Decimal? @db.Decimal(19, 4)
  createdAt    DateTime @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@index([lineType])
  @@index([sourceType, sourceId])
  @@map("settlement_lines")
}

model EarningRule {
  id              String    @id @default(cuid())
  storeId         String
  partnerId       String?
  name            String
  ruleType        String // SELF_SALE_COMMISSION, RESALE_COMMISSION, FULFILLMENT_SERVICE_FEE, SUPPLY_PROFIT_SHARE, STORAGE_FEE, LISTING_SERVICE_FEE, SOURCING_SERVICE_FEE, ADJUSTMENT
  scopeType       String    @default("STORE") // STORE, PARTNER, SUPPLY_OFFER, RESALE_LISTING, PLATFORM, SKU, ORDER
  scopeId         String?
  calculationType String // PERCENT_OF_PROFIT, PERCENT_OF_SALES, FIXED_PER_ORDER, FIXED_PER_UNIT, FIXED_MONTHLY, MANUAL
  rate            Decimal?  @db.Decimal(8, 4)
  fixedAmount     Decimal?  @db.Decimal(19, 4)
  currency        String?
  priority        Int       @default(100)
  status          String    @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  earningEvents EarningEvent[]

  @@index([storeId])
  @@index([partnerId])
  @@index([ruleType])
  @@index([scopeType, scopeId])
  @@index([status])
  @@map("earning_rules")
}

model EarningEvent {
  id              String    @id @default(cuid())
  storeId         String
  walletAccountId String?
  earningRuleId   String?
  partnerId       String?
  userId          String?
  sourceType      String // CUSTOMER_ORDER, FULFILLMENT_REQUEST, SUPPLY_OFFER, SETTLEMENT, MANUAL, MONTHLY_SERVICE
  sourceId        String?
  earningType     String // SELF_SALE_COMMISSION, RESALE_COMMISSION, FULFILLMENT_SERVICE_FEE, SUPPLY_PROFIT_SHARE, PLATFORM_REVENUE, ADJUSTMENT
  description     String
  grossAmount     Decimal   @default(0) @db.Decimal(19, 4)
  costAmount      Decimal   @default(0) @db.Decimal(19, 4)
  baseAmount      Decimal   @default(0) @db.Decimal(19, 4)
  earningAmount   Decimal   @db.Decimal(19, 4)
  currency        String
  status          String    @default("PENDING") // PENDING, CONFIRMED, SETTLED, VOID
  occurredAt      DateTime  @default(now())
  settledAt       DateTime?
  metadata        Json?
  createdById     String?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  walletAccount WalletAccount?      @relation(fields: [walletAccountId], references: [id], onDelete: SetNull)
  earningRule   EarningRule?        @relation(fields: [earningRuleId], references: [id], onDelete: SetNull)
  ledgerEntries WalletLedgerEntry[]

  @@unique([storeId, userId, sourceType, sourceId, earningType])
  @@index([storeId])
  @@index([walletAccountId])
  @@index([earningRuleId])
  @@index([partnerId])
  @@index([userId])
  @@index([sourceType, sourceId])
  @@index([earningType])
  @@index([status])
  @@index([occurredAt])
  @@map("earning_events")
}

model WalletAccount {
  id        String   @id @default(cuid())
  storeId   String
  ownerType String // USER, PARTNER, PLATFORM
  ownerId   String
  currency  String
  status    String   @default("ACTIVE") // ACTIVE, FROZEN, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  earningEvents      EarningEvent[]
  ledgerEntries      WalletLedgerEntry[]
  withdrawalRequests WithdrawalRequest[]
  payoutRecords      PayoutRecord[]

  @@unique([storeId, ownerType, ownerId, currency])
  @@index([storeId])
  @@index([ownerType, ownerId])
  @@index([status])
  @@map("wallet_accounts")
}

model WalletLedgerEntry {
  id                  String    @id @default(cuid())
  storeId             String
  walletAccountId     String
  withdrawalRequestId String?
  earningEventId      String?
  entryType           String // CREDIT, DEBIT, HOLD, RELEASE, WITHDRAWAL, ADJUSTMENT
  amount              Decimal   @db.Decimal(19, 4)
  currency            String
  status              String    @default("POSTED") // POSTED, PENDING, VOID
  sourceType          String?
  sourceId            String?
  description         String?   @db.Text
  metadata            Json?
  postedAt            DateTime?
  voidedAt            DateTime?
  createdById         String?
  createdAt           DateTime  @default(now())

  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  walletAccount     WalletAccount      @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  withdrawalRequest WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: SetNull)
  earningEvent      EarningEvent?      @relation(fields: [earningEventId], references: [id], onDelete: SetNull)

  @@unique([earningEventId])
  @@index([storeId])
  @@index([walletAccountId])
  @@index([withdrawalRequestId])
  @@index([entryType])
  @@index([status])
  @@index([sourceType, sourceId])
  @@index([createdAt])
  @@map("wallet_ledger_entries")
}

model WithdrawalRequest {
  id              String    @id @default(cuid())
  storeId         String
  walletAccountId String
  requestNo       String
  amount          Decimal   @db.Decimal(19, 4)
  currency        String
  status          String    @default("REQUESTED") // REQUESTED, APPROVED, PAID, REJECTED, CANCELLED
  paymentMethod   String?
  paymentAccount  String?
  accountName     String?
  note            String?   @db.Text
  requestedById   String?
  reviewedById    String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  cancelledAt     DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  walletAccount WalletAccount       @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  ledgerEntries WalletLedgerEntry[]
  payoutRecords PayoutRecord[]

  @@unique([storeId, requestNo])
  @@index([storeId])
  @@index([walletAccountId])
  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
  @@map("withdrawal_requests")
}

model PayoutRecord {
  id                  String   @id @default(cuid())
  storeId             String
  walletAccountId     String
  withdrawalRequestId String
  amount              Decimal  @db.Decimal(19, 4)
  currency            String
  status              String   @default("PAID") // PAID, VOID
  paymentMethod       String?
  paymentAccount      String?
  accountName         String?
  proofUrl            String?
  note                String?  @db.Text
  paidById            String?
  paidAt              DateTime @default(now())
  createdAt           DateTime @default(now())

  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  walletAccount     WalletAccount     @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  withdrawalRequest WithdrawalRequest @relation(fields: [withdrawalRequestId], references: [id], onDelete: Cascade)

  @@unique([withdrawalRequestId])
  @@index([storeId])
  @@index([walletAccountId])
  @@index([status])
  @@index([paidAt])
  @@map("payout_records")
}

model SupplyOfferItem {
  id                String   @id @default(cuid())
  offerId           String
  skuId             String?
  itemUnitId        String?
  title             String
  variantCode       String?
  quantityAvailable Decimal  @db.Decimal(19, 4)
  quantityReserved  Decimal  @default(0) @db.Decimal(19, 4)
  unitPrice         Decimal? @db.Decimal(19, 4)
  currency          String?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  offer          SupplyOffer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sku            SKU?                @relation(fields: [skuId], references: [id], onDelete: SetNull)
  itemUnit       ItemUnit?           @relation(fields: [itemUnitId], references: [id], onDelete: SetNull)
  resaleListings ResaleListing[]
  reservations   SupplyReservation[]

  @@index([offerId])
  @@index([skuId])
  @@index([itemUnitId])
  @@map("supply_offer_items")
}

model OfferVisibility {
  id                       String   @id @default(cuid())
  offerId                  String
  partnerId                String?
  viewerStoreId            String?
  viewerOrganizationId     String?
  organizationConnectionId String?
  scope                    String   @default("PARTNER") // PARTNER, STORE
  createdAt                DateTime @default(now())

  offer                  SupplyOffer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  partner                Partner?                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  viewerStore            Store?                  @relation("OfferVisibilityStore", fields: [viewerStoreId], references: [id], onDelete: Cascade)
  viewerOrganization     Organization?           @relation("OfferVisibilityOrganization", fields: [viewerOrganizationId], references: [id], onDelete: Cascade)
  organizationConnection OrganizationConnection? @relation(fields: [organizationConnectionId], references: [id], onDelete: SetNull)

  @@index([offerId])
  @@index([partnerId])
  @@index([viewerStoreId])
  @@index([viewerOrganizationId])
  @@index([organizationConnectionId])
  @@map("offer_visibility")
}

model SupplyOfferChannel {
  id                    String    @id @default(cuid())
  offerId               String
  sellerOrganizationId  String?
  storeId               String?
  salesChannelAccountId String?
  partnerId             String?
  channelType           String    @default("INTERNAL_ACCOUNT") // INTERNAL_ACCOUNT, RESELLER
  inventoryMode         String    @default("SHARED") // SHARED, GUARANTEED
  quotaQty              Decimal   @default(0) @db.Decimal(19, 4)
  quotaReservedQty      Decimal   @default(0) @db.Decimal(19, 4)
  status                String    @default("ACTIVE") // ACTIVE, PAUSED, REVOKED, EXPIRED
  expiresAt             DateTime?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  offer               SupplyOffer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sellerOrganization  Organization?        @relation("SupplyOfferChannelSellerOrganization", fields: [sellerOrganizationId], references: [id], onDelete: SetNull)
  store               Store?               @relation(fields: [storeId], references: [id], onDelete: SetNull)
  salesChannelAccount SalesChannelAccount? @relation(fields: [salesChannelAccountId], references: [id], onDelete: Cascade)
  partner             Partner?             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  resaleListings      ResaleListing[]
  reservations        SupplyReservation[]

  @@unique([offerId, salesChannelAccountId])
  @@unique([offerId, partnerId])
  @@index([offerId, status])
  @@index([sellerOrganizationId])
  @@index([storeId])
  @@index([partnerId])
  @@map("supply_offer_channels")
}

// ============================================
// FX: Exchange Rates
// ============================================

model FxRate {
  id            String   @id @default(cuid())
  fromCurrency  String
  toCurrency    String
  rate          Decimal  @db.Decimal(19, 8)
  effectiveDate DateTime
  createdAt     DateTime @default(now())

  @@unique([fromCurrency, toCurrency, effectiveDate])
  @@map("fx_rates")
}

// ============================================
// IMPORT: Batch Import Jobs
// ============================================

model ImportJob {
  id          String   @id @default(cuid())
  storeId     String
  entityType  String // SKU, INVENTORY_LOT, PURCHASE_LINE, CUSTOMER_ORDER, LISTING
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  totalRows   Int      @default(0)
  successRows Int      @default(0)
  failedRows  Int      @default(0)
  errorReport Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([entityType])
  @@map("import_jobs")
}

// ============================================
// LOGISTICS: Inbound shipments, consolidation, inspection
// ============================================

model InboundShipment {
  id              String    @id @default(cuid())
  storeId         String
  inventoryPoolId String?
  purchaseOrderId String?
  legIndex        Int       @default(1)
  fromLocationId  String?
  toLocationId    String?
  trackingNo      String?
  carrier         String?
  transportMode   String? // HAND_CARRY, CONSOLIDATOR, POSTAL, COURIER, FREIGHT, OTHER
  carriedBy       String?
  grossWeightKg   Decimal?  @db.Decimal(19, 4)
  customsAmount   Decimal?  @db.Decimal(19, 4)
  customsCurrency String?
  taxAmount       Decimal?  @db.Decimal(19, 4)
  taxCurrency     String?
  shippedAt       DateTime?
  etaDate         DateTime?
  receivedAt      DateTime?
  status          String    @default("PENDING") // PENDING, IN_TRANSIT, DELIVERED, EXCEPTION
  shipmentNote    String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store          Store                          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrder  PurchaseOrder?                 @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  fromLocation   Location?                      @relation("ShipmentFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation     Location?                      @relation("ShipmentTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  inventoryLines InboundShipmentInventoryLine[]

  @@index([storeId])
  @@index([inventoryPoolId])
  @@index([purchaseOrderId])
  @@index([status])
  @@map("inbound_shipments")
}

// Inventory carried by a logistics leg. The line is deliberately polymorphic:
// any inventory lot or individually tracked unit can use the same transfer flow,
// regardless of whether it originated from purchasing, opening stock, a split,
// or another warehouse transfer.
model InboundShipmentInventoryLine {
  id                  String   @id @default(cuid())
  shipmentId          String
  entityType          String // LOT, ITEM_UNIT
  entityId            String
  quantity            Decimal  @db.Decimal(19, 4)
  destinationEntityId String?
  status              String   @default("IN_TRANSIT") // IN_TRANSIT, RECEIVED, CANCELLED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shipment InboundShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, entityType, entityId])
  @@index([shipmentId, status])
  @@index([entityType, entityId])
  @@map("inbound_shipment_inventory_lines")
}

model ConsolidationBatch {
  id                 String    @id @default(cuid())
  storeId            String
  inventoryPoolId    String?
  fromLocationId     String?
  toLocationId       String?
  status             String    @default("OPEN") // OPEN, SEALED, SHIPPED, RECEIVED
  outboundTrackingNo String?
  carrier            String?
  shippedAt          DateTime?
  receivedAt         DateTime?
  note               String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  store        Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fromLocation Location?                @relation("ConsolidationFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location?                @relation("ConsolidationTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  lines        ConsolidationBatchLine[]

  @@index([storeId])
  @@index([inventoryPoolId])
  @@index([status])
  @@map("consolidation_batches")
}

model ConsolidationBatchLine {
  id         String  @id @default(cuid())
  batchId    String
  sourceType String // PURCHASE_LINE, LOT, ITEM_UNIT, QUICK_ENTRY
  sourceId   String
  quantity   Decimal @db.Decimal(19, 4)

  batch ConsolidationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([batchId])
  @@map("consolidation_batch_lines")
}

/// 可追溯到采购、转仓或集运单据的实际物流支出。
/// 销售订单向客户结算的 shippingFee 仍保留在 CustomerOrder，避免收支口径混淆。
model LogisticsCost {
  id         String   @id @default(cuid())
  storeId    String
  sourceType String // PURCHASE_ORDER, INBOUND_SHIPMENT, CONSOLIDATION_BATCH
  sourceId   String
  feeType    String   @default("SHIPPING")
  amount     Decimal  @db.Decimal(19, 4)
  currency   String
  occurredAt DateTime @default(now())
  note       String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, sourceType, sourceId, feeType])
  @@index([storeId, occurredAt])
  @@index([sourceType, sourceId])
  @@map("logistics_costs")
}

model InspectionEvent {
  id               String   @id @default(cuid())
  storeId          String
  inventoryPoolId  String?
  afterSalesCaseId String?
  refType          String // QUICK_ENTRY, PURCHASE_LINE, ITEM_UNIT, INBOUND_SHIPMENT
  refId            String
  locationId       String?
  result           String // PASSED, FAILED, PARTIAL
  passedQty        Decimal? @db.Decimal(19, 4)
  failedQty        Decimal? @db.Decimal(19, 4)
  pendingQty       Decimal? @db.Decimal(19, 4)
  returnedQty      Decimal? @db.Decimal(19, 4)
  details          Json?
  failureReason    String?  @db.Text
  photos           Json?
  inspectedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  location       Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  afterSalesCase AfterSalesCase? @relation(fields: [afterSalesCaseId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([inventoryPoolId])
  @@index([afterSalesCaseId])
  @@index([refType, refId])
  @@map("inspection_events")
}

// ============================================
// QUICK ENTRY: Excel-style capture + async structure
// ============================================

model QuickEntry {
  id              String  @id @default(cuid())
  storeId         String
  inventoryPoolId String?
  sourceType      String  @default("MANUAL") // MANUAL, PASTE, IMPORT

  rawBrand             String?
  rawProductName       String
  rawVariant           String?
  rawCategory          String?
  conditionType        String? // NEW, USED（兼容历史：新品, 中古）
  conditionGrade       String? // S, A, B, C, D, UNASSESSED；全新为空
  functionStatus       String? // NORMAL, ISSUE, UNTESTED
  quantity             Decimal   @default(1) @db.Decimal(19, 4)
  purchasePrice        Decimal?  @db.Decimal(19, 4)
  purchaseCurrency     String?
  purchasePlatformText String?
  purchaseDate         DateTime?
  purchaseTrackingNo   String?
  purchaseShippingFee  Decimal?  @db.Decimal(19, 4)
  currentLocationText  String?
  transitTrackingNo    String?
  transitShippingFee   Decimal?  @db.Decimal(19, 4)
  listingPlatformsText String?
  salePlatformText     String?
  saleCurrency         String?
  salePrice            Decimal?  @db.Decimal(19, 4)
  saleShippingFee      Decimal?  @db.Decimal(19, 4)
  saleMiscFee          Decimal?  @db.Decimal(19, 4)
  salePlatformFeeText  String?
  saleDate             DateTime?
  note                 String?   @db.Text
  batchNote            String?

  workflowStage    String    @default("PURCHASE") // PURCHASE, LOGISTICS, INSPECTION, LISTING, SOLD, SHIPPED, SETTLED, CLOSED
  inspectionResult String? // PASSED, FAILED, PENDING
  inspectionNote   String?   @db.Text
  inspectedAt      DateTime?

  processedStatus String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, PARTIAL, FAILED
  processedAt     DateTime?
  errorMessage    String?   @db.Text

  generatedSkuId           String?
  generatedLotId           String?
  generatedItemUnitIds     Json?
  generatedPurchaseOrderId String?
  generatedPurchaseLineId  String?
  generatedListingIds      Json?
  generatedCustomerOrderId String?
  generatedOrderLineId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([inventoryPoolId])
  @@index([processedStatus])
  @@index([workflowStage])
  @@index([createdAt])
  @@map("quick_entries")
}

// ============================================
// MULTI-PARTY: inventory pools, channels and service access
// ============================================

model InventoryPool {
  id             String   @id @default(cuid())
  organizationId String
  legacyStoreId  String?  @unique
  code           String
  name           String
  baseCurrency   String   @default("CNY")
  status         String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legacyStore  Store?                @relation(fields: [legacyStoreId], references: [id], onDelete: SetNull)
  accesses     InventoryPoolAccess[]
  agreements   ServiceAgreement[]
  supplyOffers SupplyOffer[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("inventory_pools")
}

model InventoryPoolAccess {
  id              String   @id @default(cuid())
  inventoryPoolId String
  userId          String
  role            String   @default("VIEWER")
  permissions     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inventoryPool InventoryPool @relation(fields: [inventoryPoolId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inventoryPoolId, userId])
  @@index([userId])
  @@map("inventory_pool_accesses")
}

model SalesChannelAccount {
  id                String   @id @default(cuid())
  organizationId    String
  legacyPlatformId  String?  @unique
  platformCode      String
  code              String
  name              String
  externalAccountId String?
  country           String?
  defaultCurrency   String?
  credentialRef     String?
  settings          Json?
  status            String   @default("ACTIVE") // ACTIVE, DISCONNECTED, ARCHIVED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legacyPlatform      Platform?            @relation(fields: [legacyPlatformId], references: [id], onDelete: SetNull)
  accesses            ChannelAccess[]
  listings            Listing[]
  resaleListings      ResaleListing[]
  customerOrders      CustomerOrder[]
  statements          ChannelStatement[]
  supplyOfferChannels SupplyOfferChannel[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("sales_channel_accounts")
}

model ChannelAccess {
  id                    String   @id @default(cuid())
  salesChannelAccountId String
  userId                String
  role                  String   @default("VIEWER")
  permissions           Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  salesChannelAccount SalesChannelAccount @relation(fields: [salesChannelAccountId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([salesChannelAccountId, userId])
  @@index([userId])
  @@map("channel_accesses")
}

model LocationAccess {
  id          String   @id @default(cuid())
  locationId  String
  userId      String
  role        String   @default("VIEWER")
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([locationId, userId])
  @@index([userId])
  @@map("location_accesses")
}

model ServiceAgreement {
  id                       String    @id @default(cuid())
  clientOrganizationId     String
  providerOrganizationId   String
  inventoryPoolId          String?
  locationId               String?
  serviceTypes             Json
  settlementCurrency       String
  paymentTermsDays         Int       @default(0)
  status                   String    @default("ACTIVE") // PENDING_COUNTERPARTY, ACTIVE, PAUSED, ENDED
  effectiveFrom            DateTime?
  effectiveTo              DateTime?
  notes                    String?   @db.Text
  proposedByOrganizationId String?
  acceptedById             String?
  acceptedAt               DateTime?
  pausedByOrganizationId   String?
  pausedAt                 DateTime?
  supersedesAgreementId    String?   @unique
  version                  Int       @default(1)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  clientOrganization     Organization      @relation("ServiceAgreementClient", fields: [clientOrganizationId], references: [id], onDelete: Restrict)
  providerOrganization   Organization      @relation("ServiceAgreementProvider", fields: [providerOrganizationId], references: [id], onDelete: Restrict)
  inventoryPool          InventoryPool?    @relation(fields: [inventoryPoolId], references: [id], onDelete: SetNull)
  location               Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  proposedByOrganization Organization?     @relation("ServiceAgreementProposer", fields: [proposedByOrganizationId], references: [id], onDelete: Restrict)
  pausedByOrganization   Organization?     @relation("ServiceAgreementPauser", fields: [pausedByOrganizationId], references: [id], onDelete: SetNull)
  acceptedBy             User?             @relation("ServiceAgreementAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  supersedesAgreement    ServiceAgreement? @relation("ServiceAgreementRevisions", fields: [supersedesAgreementId], references: [id], onDelete: Restrict)
  revision               ServiceAgreement? @relation("ServiceAgreementRevisions")
  chargeRules            ChargeRule[]

  @@index([clientOrganizationId, status])
  @@index([providerOrganizationId, status])
  @@index([inventoryPoolId])
  @@index([locationId])
  @@index([proposedByOrganizationId, status])
  @@index([pausedByOrganizationId, status])
  @@map("service_agreements")
}

// ============================================
// FINANCE: extensible operational sub-ledger
// ============================================

model ChargeCategory {
  id             String   @id @default(cuid())
  organizationId String?
  systemKey      String?  @unique
  scope          String   @default("ORGANIZATION") // SYSTEM, ORGANIZATION
  groupCode      String // PLATFORM, SHIPPING, FULFILLMENT, INSPECTION, STORAGE, PACKAGING, AFTER_SALES, TAX_DUTY, COMMISSION, PROCUREMENT, OTHER
  code           String
  name           String
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules        ChargeRule[]
  events       ChargeEvent[]

  @@unique([organizationId, code])
  @@index([scope, groupCode, status])
  @@map("charge_categories")
}

model ChargeRule {
  id                 String    @id @default(cuid())
  organizationId     String
  serviceAgreementId String?
  categoryId         String
  name               String
  calculationMethod  String    @default("MANUAL") // MANUAL, FIXED, PER_ITEM, PERCENTAGE
  fixedAmount        Decimal?  @db.Decimal(19, 4)
  rate               Decimal?  @db.Decimal(12, 8)
  currency           String?
  config             Json?
  status             String    @default("ACTIVE")
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  agreement ServiceAgreement? @relation(fields: [serviceAgreementId], references: [id], onDelete: SetNull)
  category  ChargeCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  events    ChargeEvent[]

  @@index([organizationId, status])
  @@index([serviceAgreementId])
  @@index([categoryId])
  @@map("charge_rules")
}

model ChargeEvent {
  id             String    @id @default(cuid())
  organizationId String
  categoryId     String
  ruleId         String?
  reversalOfId   String?
  sourceType     String
  sourceId       String
  idempotencyKey String?
  amountKind     String    @default("ACTUAL") // ESTIMATE, ACTUAL
  amount         Decimal   @db.Decimal(19, 4)
  currency       String
  baseCurrency   String?
  fxRate         Decimal?  @db.Decimal(19, 8)
  baseAmount     Decimal?  @db.Decimal(19, 4)
  status         String    @default("DRAFT") // DRAFT, SUBMITTED, CONFIRMED, DISPUTED, PARTIALLY_SETTLED, SETTLED, VOID
  description    String
  evidence       Json?
  occurredAt     DateTime  @default(now())
  submittedById  String?
  submittedAt    DateTime?
  confirmedById  String?
  confirmedAt    DateTime?
  disputedById   String?
  disputedAt     DateTime?
  disputeReason  String?   @db.Text
  voidedById     String?
  voidedAt       DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category        ChargeCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  rule            ChargeRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  reversalOf      ChargeEvent?       @relation("ChargeReversals", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals       ChargeEvent[]      @relation("ChargeReversals")
  parties         ChargeParty[]
  allocations     ChargeAllocation[]
  settlementItems SettlementItem[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, occurredAt])
  @@index([sourceType, sourceId])
  @@index([categoryId])
  @@index([reversalOfId])
  @@map("charge_events")
}

model ChargeParty {
  id             String   @id @default(cuid())
  chargeEventId  String
  role           String // PAYER, PAYEE, BENEFICIARY
  partyType      String // ORGANIZATION, USER, PARTNER, CHANNEL_ACCOUNT, CUSTOMER
  partyId        String
  organizationId String?
  nameSnapshot   String
  createdAt      DateTime @default(now())

  chargeEvent ChargeEvent @relation(fields: [chargeEventId], references: [id], onDelete: Cascade)

  @@unique([chargeEventId, role, partyType, partyId])
  @@index([organizationId, role])
  @@index([partyType, partyId])
  @@map("charge_parties")
}

model ChargeAllocation {
  id               String   @id @default(cuid())
  chargeEventId    String
  targetType       String // ORDER, ORDER_LINE, INVENTORY_POOL, SKU, FULFILLMENT_REQUEST, AFTER_SALES_CASE, LOCATION
  targetId         String
  amount           Decimal  @db.Decimal(19, 4)
  allocationMethod String   @default("MANUAL")
  createdAt        DateTime @default(now())

  chargeEvent ChargeEvent @relation(fields: [chargeEventId], references: [id], onDelete: Cascade)

  @@index([chargeEventId])
  @@index([targetType, targetId])
  @@map("charge_allocations")
}

model SettlementItem {
  id            String   @id @default(cuid())
  settlementId  String
  chargeEventId String
  amount        Decimal  @db.Decimal(19, 4)
  createdAt     DateTime @default(now())

  settlement  Settlement  @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  chargeEvent ChargeEvent @relation(fields: [chargeEventId], references: [id], onDelete: Restrict)

  @@unique([settlementId, chargeEventId])
  @@index([chargeEventId])
  @@map("settlement_items")
}

// ============================================
// CHANNEL RECONCILIATION
// ============================================

model ChannelStatement {
  id                    String    @id @default(cuid())
  organizationId        String
  salesChannelAccountId String
  externalStatementNo   String?
  periodStart           DateTime?
  periodEnd             DateTime?
  currency              String
  grossSales            Decimal   @default(0) @db.Decimal(19, 4)
  totalFees             Decimal   @default(0) @db.Decimal(19, 4)
  totalRefunds          Decimal   @default(0) @db.Decimal(19, 4)
  totalAdjustments      Decimal   @default(0) @db.Decimal(19, 4)
  netPayout             Decimal   @default(0) @db.Decimal(19, 4)
  status                String    @default("DRAFT") // DRAFT, IMPORTED, RECONCILED, CONFIRMED, VOID
  paidAt                DateTime?
  confirmedById         String?
  confirmedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  channel      SalesChannelAccount    @relation(fields: [salesChannelAccountId], references: [id], onDelete: Restrict)
  lines        ChannelStatementLine[]

  @@unique([salesChannelAccountId, externalStatementNo])
  @@index([organizationId, status])
  @@map("channel_statements")
}

model ChannelStatementLine {
  id              String    @id @default(cuid())
  statementId     String
  externalLineId  String?
  lineType        String // ORDER_GROSS, PLATFORM_FEE, PLATFORM_SHIPPING, REFUND, TAX, ADJUSTMENT, PAYOUT
  orderId         String?
  externalOrderNo String?
  amount          Decimal   @db.Decimal(19, 4)
  currency        String
  description     String?
  occurredAt      DateTime?
  matchStatus     String    @default("UNMATCHED") // UNMATCHED, MATCHED, EXCEPTION
  chargeEventId   String?
  rawData         Json?
  createdAt       DateTime  @default(now())

  statement ChannelStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([statementId, externalLineId])
  @@index([statementId, matchStatus])
  @@index([orderId])
  @@index([externalOrderNo])
  @@map("channel_statement_lines")
}

// ============================================
// AFTER SALES
// ============================================

model AfterSalesCase {
  id               String    @id @default(cuid())
  organizationId   String
  customerOrderId  String
  caseNo           String
  idempotencyKey   String?
  type             String // RETURN, REFUND_ONLY, EXCHANGE, RESHIP, REFUSED, CANCEL_AFTER_SHIP
  status           String    @default("REQUESTED") // REQUESTED, AUTHORIZED, IN_TRANSIT, RECEIVED, INSPECTING, RESOLVED, CLOSED, REJECTED
  reason           String    @db.Text
  responsibility   String? // SELLER, CUSTOMER, PLATFORM, WAREHOUSE, CARRIER, SUPPLIER, SHARED
  refundAmount     Decimal?  @db.Decimal(19, 4)
  refundCurrency   String?
  targetLocationId String?
  evidence         Json?
  requestedById    String?
  authorizedById   String?
  resolvedById     String?
  requestedAt      DateTime  @default(now())
  authorizedAt     DateTime?
  receivedAt       DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerOrder CustomerOrder        @relation(fields: [customerOrderId], references: [id], onDelete: Restrict)
  lines         AfterSalesLine[]
  shipments     AfterSalesShipment[]
  inspections   InspectionEvent[]

  @@unique([organizationId, caseNo])
  @@unique([organizationId, idempotencyKey])
  @@index([customerOrderId, status])
  @@index([targetLocationId])
  @@map("after_sales_cases")
}

model AfterSalesLine {
  id               String   @id @default(cuid())
  afterSalesCaseId String
  orderLineId      String
  quantity         Decimal  @db.Decimal(19, 4)
  resolution       String? // RESTOCK, QUARANTINE, DOWNGRADE, SCRAP, RETURN_TO_SUPPLIER, REPLACE
  conditionNote    String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  afterSalesCase AfterSalesCase      @relation(fields: [afterSalesCaseId], references: [id], onDelete: Cascade)
  orderLine      OrderLine           @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  receipts       AfterSalesReceipt[]

  @@unique([afterSalesCaseId, orderLineId])
  @@index([orderLineId])
  @@map("after_sales_lines")
}

model AfterSalesReceipt {
  id                String   @id @default(cuid())
  afterSalesLineId  String
  orderAllocationId String
  returnedLotId     String?
  itemUnitId        String?
  quantity          Decimal  @db.Decimal(19, 4)
  status            String   @default("RETURN_CHECK") // RETURN_CHECK, RESTOCKED, QUARANTINED, DOWNGRADED, SCRAPPED, RETURNED_TO_SUPPLIER
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  afterSalesLine AfterSalesLine @relation(fields: [afterSalesLineId], references: [id], onDelete: Cascade)

  @@unique([afterSalesLineId, orderAllocationId])
  @@index([returnedLotId])
  @@index([itemUnitId])
  @@map("after_sales_receipts")
}

model AfterSalesShipment {
  id               String    @id @default(cuid())
  afterSalesCaseId String
  direction        String    @default("RETURN") // RETURN, RESHIP
  fromLocationId   String?
  toLocationId     String?
  carrier          String?
  trackingNo       String?
  status           String    @default("PENDING")
  shippedAt        DateTime?
  receivedAt       DateTime?
  evidence         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  afterSalesCase AfterSalesCase @relation(fields: [afterSalesCaseId], references: [id], onDelete: Cascade)

  @@index([afterSalesCaseId, status])
  @@index([trackingNo])
  @@map("after_sales_shipments")
}

model FulfillmentInventoryAllocation {
  id                   String   @id @default(cuid())
  fulfillmentRequestId String
  lotId                String?
  itemUnitId           String?
  quantity             Decimal  @db.Decimal(19, 4)
  status               String   @default("ALLOCATED") // ALLOCATED, SHIPPED, RELEASED, RETURNED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  fulfillmentRequest FulfillmentRequest @relation(fields: [fulfillmentRequestId], references: [id], onDelete: Cascade)

  @@index([fulfillmentRequestId, status])
  @@index([lotId])
  @@index([itemUnitId])
  @@map("fulfillment_inventory_allocations")
}
