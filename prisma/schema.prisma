// ============================================
// INVENTORY: Location, Lot, ItemUnit, Ledger
// ============================================

model Location {
  id                     String   @id @default(cuid())
  storeId                String
  operatorOrganizationId String?
  code                   String
  name                   String
  region                 String? // CN_SHANGHAI, JP_TOKYO, JP_OSAKA, ...
  type                   String // WAREHOUSE, FORWARDER, PERSON, TRANSIT
  isSellableDefault      Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  store                Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  operatorOrganization Organization?        @relation("LocationOperator", fields: [operatorOrganizationId], references: [id], onDelete: Restrict)
  accesses             LocationAccess[]
  serviceAgreements    ServiceAgreement[]
  inventoryLots        InventoryLot[]
  itemUnits            ItemUnit[]
  stockLedgers         StockLedger[]
  inboundShipmentsFrom InboundShipment[]    @relation("ShipmentFrom")
  inboundShipmentsTo   InboundShipment[]    @relation("ShipmentTo")
  consolidationFrom    ConsolidationBatch[] @relation("ConsolidationFrom")
  consolidationTo      ConsolidationBatch[] @relation("ConsolidationTo")
  inspections          InspectionEvent[]
  purchaseOrdersDest   PurchaseOrder[]
  openingStockLines    OpeningStockLine[]
  capabilities         LocationCapability[]
  shippingLanesFrom    ShippingLane[]       @relation("ShippingLaneFrom")
  shippingLanesTo      ShippingLane[]       @relation("ShippingLaneTo")
  fulfillers           LocationFulfiller[]
  taskDispatches       TaskDispatch[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([operatorOrganizationId])
  @@map("locations")
}

/// 仓库级任务协作人。协作人只获得被邀请仓库的任务权限，不自动成为企业成员。
model LocationFulfiller {
  id             String    @id @default(cuid())
  organizationId String
  locationId     String
  userId         String?
  email          String
  role           String    @default("OPERATOR") // MANAGER, OPERATOR, BACKUP
  status         String    @default("INVITED") // INVITED, ACTIVE, SUSPENDED, ENDED
  isDefault      Boolean   @default(false)
  tokenHash      String?   @unique
  expiresAt      DateTime?
  invitedById    String
  acceptedAt     DateTime?
  suspendedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location                 @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user         User?                    @relation("LocationFulfillerUser", fields: [userId], references: [id], onDelete: SetNull)
  invitedBy    User                     @relation("LocationFulfillerInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  events       LocationFulfillerEvent[]

  @@unique([locationId, email])
  @@index([organizationId, status])
  @@index([locationId, status, isDefault])
  @@index([userId, status])
  @@index([expiresAt])
  @@map("location_fulfillers")
}

/// 仓库协作关系的追加式生命周期记录。权限以 LocationFulfiller 当前状态为准，
/// 事件只用于解释是谁、何时、为什么改变了关系。
model LocationFulfillerEvent {
  id          String   @id @default(cuid())
  fulfillerId String
  eventType   String // INVITED, REOPENED, ACCEPTED, ROLE_CHANGED, SUSPENDED, REACTIVATED, ENDED
  actorUserId String
  fromStatus  String?
  toStatus    String
  reason      String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  fulfiller LocationFulfiller @relation(fields: [fulfillerId], references: [id], onDelete: Cascade)
  actor     User              @relation("LocationFulfillerEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([fulfillerId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
  @@map("location_fulfiller_events")
}

/// 仓库节点的运营能力。地区只表示物理位置，能力决定节点能执行哪些动作。
model LocationCapability {
  id         String   @id @default(cuid())
  locationId String
  code       String // RECEIVE, STORE, INSPECT, CONSOLIDATE, TRANSFER, DIRECT_FULFILLMENT, RETURNS
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, code])
  @@index([locationId, enabled])
  @@map("location_capabilities")
}

/// 履约网络中的有向线路。客户配送线路用 destinationCountry，仓间线路用 toLocationId。
model ShippingLane {
  id                 String   @id @default(cuid())
  storeId            String
  fromLocationId     String
  toLocationId       String?
  laneType           String   @default("CUSTOMER_DELIVERY") // CUSTOMER_DELIVERY, WAREHOUSE_TRANSFER
  destinationCountry String? // CN, JP, US, EU, GLOBAL
  serviceLevel       String   @default("STANDARD")
  carrier            String?
  minDays            Int?
  maxDays            Int?
  priority           Int      @default(100)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fromLocation Location  @relation("ShippingLaneFrom", fields: [fromLocationId], references: [id], onDelete: Cascade)
  toLocation   Location? @relation("ShippingLaneTo", fields: [toLocationId], references: [id], onDelete: Cascade)

  @@unique([fromLocationId, laneType, destinationCountry, toLocationId, serviceLevel])
  @@index([storeId, active])
  @@index([fromLocationId, active])
  @@index([toLocationId])
  @@map("shipping_lanes")
}

model InventoryLot {
  id              String   @id @default(cuid())
  storeId         String
  inventoryPoolId String?
  skuId           String
  locationId      String
  unitCost        Decimal  @db.Decimal(19, 4)
