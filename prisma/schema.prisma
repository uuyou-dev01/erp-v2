// This is your Prisma schema file

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CollaborationScopeType {
  ORGANIZATION
  LOCATION
  ROLE
  USER
}

enum CollaborationAcceptancePolicy {
  FIRST_ACCEPT
  DIRECT_ACCEPT
  AUTHORIZED_APPROVAL
}

enum CollaborationRequestStatus {
  OPEN
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED
  EXPIRED
  CLOSED
}

enum CollaborationResponseDecision {
  ACCEPT
  REJECT
  APPROVE
  DENY
}

enum CollaborationEventType {
  REQUESTED
  RESPONSE_RECORDED
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED
  EXPIRED
  CLOSED
  TASK_DISPATCHED
  TASK_ACCEPTED
  TASK_REJECTED
  TASK_RETURNED
  TASK_COMPLETED
}

enum TaskDispatchStatus {
  QUEUED
  CLAIMED
  COMPLETED
  CANCELLED
}

// ============================================
// CORE: Store & Multi-tenancy
// ============================================

model Organization {
  id                String   @id @default(cuid())
  name              String
  code              String   @unique
  collaborationCode String   @unique @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stores                      Store[]
  memberships                 Membership[]
  productCategories           ProductCategory[]
  inventoryPools              InventoryPool[]
  salesChannelAccounts        SalesChannelAccount[]
  operatedLocations           Location[]               @relation("LocationOperator")
  serviceAgreementsAsClient   ServiceAgreement[]       @relation("ServiceAgreementClient")
  serviceAgreementsAsProvider ServiceAgreement[]       @relation("ServiceAgreementProvider")
  serviceAgreementsProposed   ServiceAgreement[]       @relation("ServiceAgreementProposer")
  serviceAgreementsPaused     ServiceAgreement[]       @relation("ServiceAgreementPauser")
  chargeCategories            ChargeCategory[]
  channelStatements           ChannelStatement[]
  afterSalesCases             AfterSalesCase[]
  ownedSupplyOffers           SupplyOffer[]            @relation("SupplyOfferOwnerOrganization")
  providedSupplyOffers        SupplyOffer[]            @relation("SupplyOfferProviderOrganization")
  supplyOfferChannels         SupplyOfferChannel[]     @relation("SupplyOfferChannelSellerOrganization")
  partnerProfiles             Partner[]                @relation("PartnerOrganization")
  offerVisibilityRules        OfferVisibility[]        @relation("OfferVisibilityOrganization")
  invitations                 OrganizationInvitation[]
  connectionsRequested        OrganizationConnection[] @relation("OrganizationConnectionRequester")
  connectionsReceived         OrganizationConnection[] @relation("OrganizationConnectionTarget")
  locationFulfillers          LocationFulfiller[]
  workTypes                   WorkType[]
  workRecords                 WorkRecord[]
  collaborationRequests       CollaborationRequest[]

  @@map("organizations")
}

model Store {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  code           String   @unique
  currency       String   @default("CNY")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization             Organization?                    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  users                    User[]
  storeAccesses            StoreAccess[]
  skus                     SKU[]
  productIntelItems        ProductIntelligenceItem[]
  productIntelObservations ProductIntelligenceObservation[]
  locations                Location[]
  inventoryLots            InventoryLot[]
  itemUnits                ItemUnit[]
  stockLedgers             StockLedger[]
  openingStocks            OpeningStock[]
  purchaseOrders           PurchaseOrder[]
  customerOrders           CustomerOrder[]
  inventorySplits          InventorySplit[]
  platforms                Platform[]
  listings                 Listing[]
  resaleListings           ResaleListing[]
  supplyReservations       SupplyReservation[]
  fulfillmentRequests      FulfillmentRequest[]
  settlements              Settlement[]
  earningRules             EarningRule[]
  earningEvents            EarningEvent[]
  walletAccounts           WalletAccount[]
  walletLedgerEntries      WalletLedgerEntry[]
  withdrawalRequests       WithdrawalRequest[]
  payoutRecords            PayoutRecord[]
  partners                 Partner[]
  tradingRelationships     TradingRelationship[]
  supplyOffers             SupplyOffer[]
  offerVisibilityRules     OfferVisibility[]                @relation("OfferVisibilityStore")
  importJobs               ImportJob[]
  quickEntries             QuickEntry[]
  inboundShipments         InboundShipment[]
  consolidationBatches     ConsolidationBatch[]
  logisticsCosts           LogisticsCost[]
  inspectionEvents         InspectionEvent[]
  inventoryPool            InventoryPool?
  shippingLanes            ShippingLane[]
  supplyOfferChannels      SupplyOfferChannel[]
  invitationScopes         OrganizationInvitationStore[]
  workRecords              WorkRecord[]

  @@index([organizationId])
  @@map("stores")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  password        String
  role            String    @default("USER")
  storeId         String?
  emailVerifiedAt DateTime?
  sessionVersion  Int       @default(1)
  accountStatus   String    @default("ACTIVE") // ACTIVE, SUSPENDED, CLOSED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store                        Store?                        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  memberships                  Membership[]
  storeAccesses                StoreAccess[]
  inventoryPoolAccesses        InventoryPoolAccess[]
  channelAccesses              ChannelAccess[]
  locationAccesses             LocationAccess[]
  invitationsSent              OrganizationInvitation[]      @relation("OrganizationInvitationInviter")
  invitationsAccepted          OrganizationInvitation[]      @relation("OrganizationInvitationAcceptor")
  connectionsRequested         OrganizationConnection[]      @relation("OrganizationConnectionRequesterUser")
  connectionsResponded         OrganizationConnection[]      @relation("OrganizationConnectionResponderUser")
  locationFulfillerAssignments LocationFulfiller[]           @relation("LocationFulfillerUser")
  locationFulfillerInvitations LocationFulfiller[]           @relation("LocationFulfillerInviter")
  locationFulfillerEvents      LocationFulfillerEvent[]      @relation("LocationFulfillerEventActor")
  serviceAgreementsAccepted    ServiceAgreement[]            @relation("ServiceAgreementAcceptor")
  workRecords                  WorkRecord[]
  collaborationRequestsCreated CollaborationRequest[]        @relation("CollaborationRequestCreator")
  taskDispatchesClaimed        TaskDispatch[]                @relation("TaskDispatchClaimedBy")
  authTokens                   AuthToken[]                   @relation("AuthTokenUser")
  authTokensCreated            AuthToken[]                   @relation("AuthTokenCreator")
  authAuditEvents              AuthAuditEvent[]
  connectionEvents             OrganizationConnectionEvent[]

  @@index([storeId])
  @@map("users")
}

model AuthToken {
  id          String    @id @default(cuid())
  userId      String
  type        String // RESET_PASSWORD
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  user      User  @relation("AuthTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AuthTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, type, consumedAt, expiresAt])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model AuthRateLimitBucket {
  id          String   @id @default(cuid())
  action      String
  subjectHash String
  windowStart DateTime
  attempts    Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([action, subjectHash, windowStart])
  @@index([expiresAt])
  @@map("auth_rate_limit_buckets")
}

model AuthAuditEvent {
  id            String   @id @default(cuid())
  userId        String?
  eventType     String
  outcome       String
  subjectHash   String?
  ipHash        String?
  userAgentHash String?
  metadata      Json?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, outcome, createdAt])
  @@index([subjectHash, createdAt])
  @@map("auth_audit_events")
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("VIEWER")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model OrganizationInvitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           String
  tokenHash      String    @unique
  status         String    @default("PENDING") // PENDING, ACCEPTED, REVOKED, EXPIRED
  expiresAt      DateTime
  invitedById    String
  acceptedById   String?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User                          @relation("OrganizationInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?                         @relation("OrganizationInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  storeScopes  OrganizationInvitationStore[]

  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@map("organization_invitations")
}

model OrganizationInvitationStore {
  id           String @id @default(cuid())
  invitationId String
  storeId      String

  invitation OrganizationInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  store      Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([invitationId, storeId])
  @@index([storeId])
  @@map("organization_invitation_stores")
}

model StoreAccess {
  id          String   @id @default(cuid())
  storeId     String
  userId      String
  role        String   @default("VIEWER")
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_accesses")
}

model Task {
  id                    String    @id @default(cuid())
  organizationId        String
  storeId               String
  type                  String
  status                String    @default("OPEN")
  priority              String    @default("NORMAL")
  title                 String
  description           String?   @db.Text
  refType               String
  refId                 String
  createdById           String
  assignedToId          String?
  delegatedToId         String?
  completedById         String?
  assignedAt            DateTime?
  dueAt                 DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  fulfillmentLocationId String?
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workRecords WorkRecord[]
  dispatch    TaskDispatch?

  @@index([organizationId])
  @@index([storeId])
  @@index([type])
  @@index([status])
  @@index([assignedToId])
  @@index([completedById])
  @@index([refType, refId])
  @@index([fulfillmentLocationId, status])
  @@map("tasks")
}

/// 通用协作协议请求。scopeType + scopeRef 构成多态参与方，支持组织、仓库、角色或个人。
model CollaborationRequest {
  id                 String                        @id @default(cuid())
  organizationId     String
  protocol           String
  protocolVersion    Int                           @default(1)
  kind               String
  status             CollaborationRequestStatus    @default(OPEN)
  acceptancePolicy   CollaborationAcceptancePolicy
  requesterScopeType CollaborationScopeType
  requesterScopeRef  String
  targetScopeType    CollaborationScopeType
  targetScopeRef     String
  parentRequestId    String?
  idempotencyKey     String
  payload            Json?
  expiresAt          DateTime?
  resolvedAt         DateTime?
  resolutionCode     String?
  cancelledAt        DateTime?
  createdById        String
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                    @relation("CollaborationRequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  parent       CollaborationRequest?   @relation("CollaborationRequestChildren", fields: [parentRequestId], references: [id], onDelete: SetNull)
  children     CollaborationRequest[]  @relation("CollaborationRequestChildren")
  responses    CollaborationResponse[]
  events       CollaborationEvent[]
  dispatches   TaskDispatch[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([protocol, kind, status])
  @@index([targetScopeType, targetScopeRef, status])
  @@index([parentRequestId])
  @@index([expiresAt, status])
  @@map("collaboration_requests")
}

/// 不可变、幂等的协作响应；同一响应方可通过不同幂等键记录审批、领取等独立决定。
model CollaborationResponse {
  id                 String                        @id @default(cuid())
  requestId          String
  responderScopeType CollaborationScopeType
  responderScopeRef  String
  decision           CollaborationResponseDecision
  idempotencyKey     String
  payload            Json?
  respondedAt        DateTime                      @default(now())
  createdAt          DateTime                      @default(now())

  request CollaborationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  events  CollaborationEvent[]

  @@unique([requestId, idempotencyKey])
  @@index([requestId, responderScopeType, responderScopeRef])
  @@index([requestId, decision, respondedAt])
  @@map("collaboration_responses")
}

/// 协作协议的追加式事件流；dedupeKey 保证调用方重试不会重复记事件。
model CollaborationEvent {
  id             String                  @id @default(cuid())
  requestId      String
  responseId     String?
  dispatchId     String?
  type           CollaborationEventType
  actorScopeType CollaborationScopeType?
  actorScopeRef  String?
  dedupeKey      String
  payload        Json?
  occurredAt     DateTime                @default(now())
  createdAt      DateTime                @default(now())

  request  CollaborationRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  response CollaborationResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)
  dispatch TaskDispatch?          @relation(fields: [dispatchId], references: [id], onDelete: SetNull)

  @@unique([requestId, dedupeKey])
  @@index([requestId, occurredAt])
  @@index([responseId])
  @@index([dispatchId])
  @@map("collaboration_events")
}

/// 一个现有 Task 可选地绑定一个协议派发；协议请求本身也可独立派发。
model TaskDispatch {
  id                   String                 @id @default(cuid())
  requestId            String
  taskId               String?                @unique
  targetScopeType      CollaborationScopeType
  targetScopeRef       String
  requiredCapability   String?
  capabilityLocationId String?
  status               TaskDispatchStatus     @default(QUEUED)
  idempotencyKey       String
  claimedByUserId      String?
  claimedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  request            CollaborationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  task               Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  claimedBy          User?                @relation("TaskDispatchClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  capabilityLocation Location?            @relation(fields: [capabilityLocationId], references: [id], onDelete: SetNull)
  events             CollaborationEvent[]

  @@unique([requestId, idempotencyKey])
  @@index([requestId, status])
  @@index([targetScopeType, targetScopeRef, status])
  @@index([claimedByUserId, status])
  @@index([capabilityLocationId])
  @@map("task_dispatches")
}

/// 可由组织扩展的工作类型。统计和后续计件规则读取数据，不依赖代码中的固定枚举。
model WorkType {
  id                 String   @id @default(cuid())
  organizationId     String
  code               String
  name               String
  unit               String
  status             String   @default("ACTIVE") // ACTIVE, ARCHIVED
  pointsPerUnit      Decimal? @db.Decimal(19, 4)
  settlementRate     Decimal? @db.Decimal(19, 4)
  settlementCurrency String?
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      WorkRecord[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("work_types")
}

/// 追加式工作量事实。金额不写入这里；之后可按工作类型、数量和有效期规则计算。
model WorkRecord {
  id                     String   @id @default(cuid())
  organizationId         String
  storeId                String
  userId                 String
  workTypeId             String
  taskId                 String?
  sourceType             String
  sourceId               String
  workCode               String
  workName               String
  quantity               Decimal  @db.Decimal(19, 4)
  unit                   String
  relationshipType       String   @default("UNKNOWN") // SELF, MEMBER, WAREHOUSE_COLLABORATOR, PARTNER_ORGANIZATION, UNKNOWN
  locationId             String?
  executorOrganizationId String?
  status                 String   @default("CONFIRMED") // CONFIRMED, VOID
  dedupeKey              String
  occurredAt             DateTime @default(now())
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workType     WorkType     @relation(fields: [workTypeId], references: [id], onDelete: Restrict)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, occurredAt])
  @@index([storeId, occurredAt])
  @@index([userId, occurredAt])
  @@index([workTypeId, occurredAt])
  @@index([relationshipType, occurredAt])
  @@index([locationId, occurredAt])
  @@index([executorOrganizationId, occurredAt])
  @@index([sourceType, sourceId])
  @@index([taskId])
  @@map("work_records")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  storeId        String?
  recipientId    String
  actorId        String?
  taskId         String?
  refType        String?
  refId          String?
  type           String
  title          String
  body           String?   @db.Text
  actionUrl      String?
  priority       String    @default("NORMAL")
  dedupeKey      String?
  readAt         DateTime?
  resolvedAt     DateTime?
  resolutionCode String?
  resolvedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  outbox NotificationOutbox?

  @@unique([recipientId, dedupeKey])
  @@index([organizationId])
  @@index([storeId])
  @@index([recipientId])
  @@index([actorId])
  @@index([taskId])
  @@index([readAt])
  @@index([resolvedAt])
  @@map("notifications")
}

model NotificationPreference {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  pushEnabled    Boolean  @default(true)
  digestMode     String   @default("IMMEDIATE") // IMMEDIATE, HOURLY, DAILY
  quietStart     String?
  quietEnd       String?
  mutedTypes     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("notification_preferences")
}

model NotificationOutbox {
  id             String    @id @default(cuid())
  notificationId String    @unique
  organizationId String
  userId         String
  status         String    @default("PENDING") // PENDING, PROCESSING, DELIVERED, RETRY, SKIPPED
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  deliveredAt    DateTime?
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([organizationId, userId])
  @@map("notification_outbox")
}

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String?
  actorId        String?
  action         String
  refType        String
  refId          String
  taskId         String?
  before         Json?
  after          Json?
  message        String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([storeId])
  @@index([actorId])
  @@index([action])
  @@index([refType, refId])
  @@index([taskId])
  @@map("activity_logs")
}

model MobileActionRequest {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  deviceId        String?
  idempotencyKey  String
  taskId          String?
  workItemId      String
  action          String
  requestHash     String
  requestPayload  Json?
  status          String   @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  responsePayload Json?
  errorMessage    String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, userId, idempotencyKey])
  @@index([organizationId])
  @@index([userId])
  @@index([taskId])
  @@index([workItemId])
  @@index([status])
  @@map("mobile_action_requests")
}

model MobileRateLimitBucket {
  id             String   @id @default(cuid())
  organizationId String
  subjectId      String
  key            String
  windowStart    DateTime
  count          Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, subjectId, key, windowStart])
  @@index([expiresAt])
  @@map("mobile_rate_limit_buckets")
}

// ============================================
// PRODUCT: SKU
// ============================================

model SKU {
  id               String   @id @default(cuid())
  storeId          String
  inventoryPoolId  String?
  code             String
  name             String
  parentSkuId      String?
  catalogRole      String   @default("SIMPLE") // GROUP, VARIANT, SIMPLE
  manufacturerCode String?
  variantLabel     String?
  variantAxes      Json?
  variantValues    Json?
  nameSource       String   @default("AUTO") // AUTO, MANUAL
  codeSource       String   @default("AUTO") // AUTO, MANUAL
  category         String?
  categoryId       String?
  brand            String?
  attributes       Json?
  description      String?
  imageUrl         String?
  isAutoCreated    Boolean  @default(false)
  mergeStatus      String? // PENDING, CONFIRMED, MERGED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store             Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productCategory   ProductCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parentSku         SKU?                      @relation("SkuVariants", fields: [parentSkuId], references: [id], onDelete: SetNull)
  childSkus         SKU[]                     @relation("SkuVariants")
  inventoryLots     InventoryLot[]
  itemUnits         ItemUnit[]
  purchaseLines     PurchaseLine[]
  orderLines        OrderLine[]
  listings          Listing[]
  supplyOffers      SupplyOffer[]
  supplyOfferItems  SupplyOfferItem[]
  openingStockLines OpeningStockLine[]
  intelligenceItems ProductIntelligenceItem[]
  captureLines      CapturePurchaseLine[]
  matchCandidates   MatchCandidate[]
  aliases           SkuAlias[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([inventoryPoolId])
  @@index([storeId, catalogRole])
  @@index([parentSkuId])
  @@index([categoryId])
  @@index([manufacturerCode])
  @@map("skus")
}

model ProductCategory {
  id                  String   @id @default(cuid())
  scope               String   @default("ORGANIZATION") // SYSTEM, ORGANIZATION
  organizationId      String?
  parentId            String?
  canonicalCategoryId String?
  mergedIntoId        String?
  code                String
  name                String
  aliases             Json?
  path                String
  level               Int      @default(0)
  sortOrder           Int      @default(0)
  status              String   @default("ACTIVE") // ACTIVE, INACTIVE, MERGED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization      Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent            ProductCategory?          @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          ProductCategory[]         @relation("ProductCategoryTree")
  canonicalCategory ProductCategory?          @relation("ProductCategoryCanonical", fields: [canonicalCategoryId], references: [id], onDelete: SetNull)
  mappedCategories  ProductCategory[]         @relation("ProductCategoryCanonical")
  mergedInto        ProductCategory?          @relation("ProductCategoryMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedCategories  ProductCategory[]         @relation("ProductCategoryMerge")
  skus              SKU[]
  intelligenceItems ProductIntelligenceItem[]

  @@unique([organizationId, code])
  @@index([scope, status])
  @@index([organizationId, status])
  @@index([parentId])
  @@index([canonicalCategoryId])
  @@index([mergedIntoId])
