model ProductIntelligenceCapture {
  id                String    @id @default(cuid())
  organizationId    String
  storeId           String
  userId            String
  deviceId          String?
  idempotencyKey    String?
  captureType       String    @default("MANUAL")
  businessIntent    String    @default("UNDECIDED")
  status            String    @default("RECEIVED")
  sourceUrl         String?   @db.Text
  normalizedUrl     String?   @db.Text
  sourceText        String?   @db.Text
  platformName      String?
  externalListingId String?
  title             String?
  amount            Decimal?  @db.Decimal(19, 4)
  currency          String?
  conditionText     String?
  visibility        String    @default("ORGANIZATION")
  rawPayload        Json?
  capturedAt        DateTime  @default(now())
  importedAt        DateTime?
  dismissedAt       DateTime?
  errorMessage      String?   @db.Text
  duplicateOfId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  duplicateOf     ProductIntelligenceCapture?      @relation("CaptureDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
