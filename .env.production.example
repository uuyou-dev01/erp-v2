# Compose and release identity
ERP_DOMAIN=erp.example.com
ACME_EMAIL=ops@example.com
APP_BASE_URL=https://erp.example.com
APP_VERSION=0.9.0-rc.1
GIT_SHA=replace-with-full-git-sha
BUILD_DATE=2026-08-28T00:00:00Z
TZ=Asia/Shanghai

# PostgreSQL is reachable only on the private Compose network.
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=replace-with-strong-database-password
DATABASE_URL=postgresql://erp:replace-with-url-encoded-password@db:5432/erp?schema=public&connection_limit=5&pool_timeout=10

# Required independent secrets; each must contain at least 32 random characters.
ERP_SESSION_SECRET=replace-with-random-session-secret
AUTH_AUDIT_PEPPER=replace-with-independent-random-audit-pepper
MOBILE_CRON_SECRET=replace-with-random-mobile-cron-secret
FX_SYNC_TOKEN=replace-with-random-fx-sync-token
AUTH_SELF_SIGNUP_ENABLED=false

# Persistent assets
ERP_ASSET_ROOT=/app/.data/assets
MOBILE_ASSET_DRIVER=local
MOBILE_EVIDENCE_RETENTION_DAYS=180

# Resource limits for a 2-core/4-GB server
CAPTURE_CONCURRENCY=1
CAPTURE_QUEUE_TIMEOUT_MS=60000
OCR_CONCURRENCY=1
OCR_QUEUE_TIMEOUT_MS=60000
WEB_CAPTURE_FETCH_TIMEOUT_MS=6000
WEB_CAPTURE_BROWSER_TIMEOUT_MS=25000
WEB_CAPTURE_MAX_HTML_BYTES=2097152

# Optional Web Push: configure all four values or leave all four empty.
NEXT_PUBLIC_WEB_PUSH_VAPID_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Optional off-host backup destination used by scripts/backup-production.sh.
OSS_BACKUP_URI=oss://replace-with-private-bucket/erp-v2
