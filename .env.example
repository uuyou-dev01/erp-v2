# Database
# For local development (no password needed)
DATABASE_URL="postgresql://postgres:@localhost:5432/erp?schema=public"

# Tests never use DATABASE_URL directly. The database name must end in _test or _e2e.
# TEST_DATABASE_URL="postgresql://postgres:@localhost:5432/erp_e2e?schema=public"

# Explicit source/target for the guarded backup and retention CLI. There is no DATABASE_URL fallback.
# RETENTION_DATABASE_URL="postgresql://postgres:@localhost:5432/erp_release?schema=public"
# Optional directory containing psql, pg_dump and pg_restore (for example /opt/homebrew/opt/libpq/bin)
# PG_BIN="/opt/homebrew/opt/libpq/bin"

# Or with password (if you set one)
# DATABASE_URL="postgresql://uuyxn:your_password@localhost:5432/erp_v2?schema=public"

# Production runtime identity and required independent secrets
# APP_BASE_URL="https://erp.example.com"
# APP_VERSION="0.9.0-rc.1"
# GIT_SHA="replace-with-full-git-sha"
# BUILD_DATE="2026-08-28T00:00:00Z"
# FX_SYNC_TOKEN="replace-with-a-different-32-character-secret"

# Required in production. Use two independent random values of at least 32 characters.
# ERP_SESSION_SECRET="replace-with-a-random-session-secret"
# AUTH_AUDIT_PEPPER="replace-with-an-independent-random-audit-pepper"

# Self signup is disabled in every environment unless explicitly enabled.
# Keep this unset/false in production; invitation-scoped registration still works.
# AUTH_SELF_SIGNUP_ENABLED="true"
# AUTH_RESET_TOKEN_TTL_MINUTES="30"

# Redis (for later)
# REDIS_URL="redis://localhost:6379"

# Mobile Web Push (optional; generate with `npx web-push generate-vapid-keys`)
# NEXT_PUBLIC_WEB_PUSH_VAPID_KEY="your-public-vapid-key"
# WEB_PUSH_VAPID_PUBLIC_KEY="your-public-vapid-key"
# WEB_PUSH_VAPID_PRIVATE_KEY="your-private-vapid-key"
# WEB_PUSH_SUBJECT="mailto:admin@example.com"

# Mobile evidence storage (local by default; use s3 for AWS S3, R2 or MinIO)
MOBILE_ASSET_DRIVER="local"
# MOBILE_ASSET_S3_BUCKET="erp-mobile-assets"
# MOBILE_ASSET_S3_REGION="ap-east-1"
# MOBILE_ASSET_S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# MOBILE_ASSET_S3_ACCESS_KEY_ID="your-access-key"
# MOBILE_ASSET_S3_SECRET_ACCESS_KEY="your-secret-key"
# MOBILE_ASSET_S3_FORCE_PATH_STYLE="false"

# Protects notification, retention and health scheduler endpoints
# MOBILE_CRON_SECRET="replace-with-a-long-random-secret"

# Production local persistent asset root (the whole .data directory is mounted by Compose)
# ERP_ASSET_ROOT="/app/.data/assets"

# Optional mobile rollout flags (true by default)
# MOBILE_FEATURE_CAPTURE="true"
# MOBILE_FEATURE_WEB_PUSH="true"
# MOBILE_FEATURE_BARCODE="true"
# MOBILE_FEATURE_BATCH_ACTIONS="true"
# MOBILE_FEATURE_CONTINUOUS_SHIPPING="true"
# MOBILE_FEATURE_OCR="true"

# Web 商品链接解析（普通请求失败时使用匿名浏览器渲染）
# macOS 本地开发可使用已安装的 Chrome；Linux 生产环境建议执行 npx playwright install --with-deps chromium
# WEB_CAPTURE_BROWSER_CHANNEL="chrome"
# WEB_CAPTURE_FETCH_TIMEOUT_MS="6000"
# WEB_CAPTURE_BROWSER_TIMEOUT_MS="25000"
# WEB_CAPTURE_MAX_HTML_BYTES="2097152"
# CAPTURE_CONCURRENCY="1"
# CAPTURE_QUEUE_TIMEOUT_MS="60000"
# OCR_CONCURRENCY="1"
# OCR_QUEUE_TIMEOUT_MS="60000"

# Evidence is redacted after a dismissed capture reaches this age
# MOBILE_EVIDENCE_RETENTION_DAYS="180"
